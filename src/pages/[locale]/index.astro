---
export { localeStaticPaths as getStaticPaths } from '@/i18n';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaBand from '@/components/CtaBand.astro';
import Hero from '@/components/sections/Hero.astro';
import Positioning from '@/components/sections/Positioning.astro';
import ProcessPreview from '@/components/sections/ProcessPreview.astro';
import ServiceCards from '@/components/sections/ServiceCards.astro';
import { useI18n } from '@/i18n';

const { t } = useI18n(Astro);
---

<BaseLayout title={t.meta.siteShortDescription} description={t.meta.siteDescription} withBusinessSchema>
  <Hero />
  <Positioning />
  <ServiceCards />
  <ProcessPreview />
  <CtaBand />
</BaseLayout>
