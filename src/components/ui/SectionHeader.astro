---
/**
 * Eyebrow plus section title on the 12-column grid. The heading is always an
 * <h2>: sections are children of the page's <h1>.
 */
interface Props {
  label: string;
  title: string;
  /** Element id for the heading, referenced by the section's aria-labelledby. */
  titleId: string;
  /** Optional index shown before the label (home page only). */
  number?: string;
  /** Optional link shown at the end of the header row, e.g. "Ver todos". */
  link?: { href: string; label: string };
}

const { label, title, titleId, number, link } = Astro.props;
---

<div class="section-header reveal">
  <p class="eyebrow">
    {number && <span class="eyebrow__num">{number}</span>}
    {label}
  </p>
  <h2 class="section-header__title" id={titleId}>{title}</h2>
  {link && (
    <a class="section-header__link" href={link.href}>
      <span>{link.label}</span>
      <span aria-hidden="true">→</span>
    </a>
  )}
</div>

<style>
  .section-header {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--col-gap);
    row-gap: var(--space-4);
    align-items: end;
    padding-bottom: var(--space-stack);
    border-bottom: 1px solid var(--color-rule);
    margin-bottom: var(--space-section-gap);
  }

  .eyebrow {
    grid-column: 1 / 4;
    align-self: start;
    padding-top: var(--space-2);
  }

  .section-header__title {
    grid-column: 5 / 11;
    font-size: var(--text-2xl);
    line-height: var(--leading-snug);
  }

  .section-header__link {
    grid-column: 11 / 13;
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-primary-strong);
    padding: 0.35rem 0;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .section-header__link:hover,
  .section-header__link:focus-visible {
    color: var(--color-text);
  }

  .section-header__link span:last-child {
    transition: transform var(--duration-base) var(--ease-out);
  }

  .section-header__link:hover span:last-child {
    transform: translateX(4px);
  }

  @media (max-width: 1100px) {
    .eyebrow {
      grid-column: 1 / 3;
    }

    .section-header__title {
      grid-column: 4 / 11;
    }
  }

  @media (max-width: 900px) {
    .section-header {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }

    .eyebrow {
      padding-top: 0;
    }

    .section-header__link {
      justify-self: start;
    }
  }
</style>
