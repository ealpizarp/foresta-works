---
/**
 * Previous / next page links so inner pages form a clear sequence.
 */
import { adjacentPages, primaryNav } from '@/data/navigation';
import { useI18n } from '@/i18n';

const { locale, t } = useI18n(Astro);
const { previous, next } = adjacentPages(primaryNav(locale), Astro.url.pathname);
---

{(previous || next) && (
  <nav class="page-nav" aria-label={t.nav.relatedPages}>
    <div class="container page-nav__grid">
      {previous ? (
        <a class="page-nav__item page-nav__item--prev panel" href={previous.href}>
          <span class="page-nav__dir">{t.nav.previous}</span>
          <span class="page-nav__label">
            <span aria-hidden="true">←</span>
            {previous.label}
          </span>
          <span class="page-nav__summary">{previous.summary}</span>
        </a>
      ) : (
        <span></span>
      )}
      {next && (
        <a class="page-nav__item page-nav__item--next panel" href={next.href}>
          <span class="page-nav__dir">{t.nav.next}</span>
          <span class="page-nav__label">
            {next.label}
            <span aria-hidden="true">→</span>
          </span>
          <span class="page-nav__summary">{next.summary}</span>
        </a>
      )}
    </div>
  </nav>
)}

<style>
  .page-nav {
    padding-top: 0;
    padding-bottom: var(--space-6);
  }

  .page-nav__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: var(--col-gap);
    row-gap: var(--space-5);
  }

  .page-nav__item {
    display: grid;
    gap: var(--space-2);
    max-width: 38ch;
    padding: var(--space-inset);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .page-nav__item:hover,
  .page-nav__item:focus-visible {
    color: var(--color-primary-strong);
  }

  .page-nav__item--next {
    justify-self: end;
    text-align: right;
  }

  .page-nav__dir {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .page-nav__label {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-3);
    font-family: var(--font-serif);
    font-weight: var(--weight-heading);
    font-size: var(--text-xl);
    line-height: 1.15;
  }

  .page-nav__label span:last-child,
  .page-nav__item--prev .page-nav__label span:first-child {
    color: var(--color-primary);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .page-nav__item--prev:hover .page-nav__label span:first-child,
  .page-nav__item--prev:focus-visible .page-nav__label span:first-child {
    transform: translateX(-4px);
  }

  .page-nav__item--next:hover .page-nav__label span:last-child,
  .page-nav__item--next:focus-visible .page-nav__label span:last-child {
    transform: translateX(4px);
  }

  .page-nav__summary {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  @media (max-width: 600px) {
    .page-nav__grid {
      grid-template-columns: 1fr;
    }

    .page-nav__item--next {
      justify-self: start;
      text-align: left;
    }
  }
</style>
