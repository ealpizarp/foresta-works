---
import Button from '@/components/ui/Button.astro';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';
import Wordmark from '@/components/Wordmark.astro';
import { isCurrentPage, primaryNav } from '@/data/navigation';
import { whatsappUrl } from '@/data/site';
import { routes, useI18n } from '@/i18n';

const { locale, t, path } = useI18n(Astro);
const whatsapp = whatsappUrl(t.meta.whatsappMessage);
const currentPath = Astro.url.pathname;
const nav = primaryNav(locale);
const onContact = isCurrentPage(path(routes.contacto), currentPath);
---

<header class="site-header">
  <div class="site-header__inner">
    <Wordmark />

    <nav class="site-nav" aria-label={t.nav.primaryLabel}>
      <ul class="site-nav__list">
        {nav.map((item) => {
          const current = isCurrentPage(item.href, currentPath);
          return (
            <li>
              <a class="site-nav__link" href={item.href} aria-current={current ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="site-header__actions">
      <LanguageSwitcher />

      {!onContact &&
        (whatsapp !== null ? (
          <Button href={whatsapp} size="sm" external>WhatsApp</Button>
        ) : (
          <Button href={path(routes.contacto)} size="sm">{t.nav.letsTalk}</Button>
        ))}

      {/*
        The mobile menu uses the HTML popover API: no JavaScript is needed to
        open, close (Escape / light dismiss) or manage focus.
      */}
      <button
        class="menu-toggle"
        type="button"
        popovertarget="site-menu"
        aria-controls="site-menu"
        aria-haspopup="dialog"
        aria-expanded="false"
      >
        <span class="menu-toggle__open">{t.nav.menuOpen}</span>
        <span class="menu-toggle__close" aria-hidden="true">{t.nav.menuClose}</span>
      </button>
    </div>
  </div>

  <div id="site-menu" class="site-menu" popover>
    {!onContact && (
      <div class="site-menu__talk">
        {whatsapp !== null ? (
          <Button href={whatsapp} external>WhatsApp</Button>
        ) : (
          <Button href={path(routes.contacto)}>{t.nav.letsTalk}</Button>
        )}
      </div>
    )}
    <nav aria-label={t.nav.menuLabel}>
      <ol class="site-menu__list">
        {nav.map((item, index) => {
          const current = isCurrentPage(item.href, currentPath);
          return (
            <li>
              <a class="site-menu__link" href={item.href} aria-current={current ? 'page' : undefined}>
                <span class="site-menu__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <span class="site-menu__text">
                  <span class="site-menu__label">{item.label}</span>
                  <span class="site-menu__summary">{item.summary}</span>
                </span>
              </a>
            </li>
          );
        })}
      </ol>
    </nav>
    <div class="site-menu__foot">
      <p>{t.meta.siteShortDescription}</p>
      <LanguageSwitcher />
    </div>
  </div>

  <script is:inline>
    (function () {
      var menu = document.getElementById('site-menu');
      var toggle = document.querySelector('.menu-toggle');
      if (!menu || !toggle || menu.dataset.fwMenuBound) return;
      menu.dataset.fwMenuBound = 'true';
      var openLabel = toggle.querySelector('.menu-toggle__open');
      var closeLabel = toggle.querySelector('.menu-toggle__close');
      function sync() {
        var open = menu.matches(':popover-open');
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        if (openLabel) openLabel.setAttribute('aria-hidden', open ? 'true' : 'false');
        if (closeLabel) closeLabel.setAttribute('aria-hidden', open ? 'false' : 'true');
      }
      menu.addEventListener('toggle', sync);
      toggle.addEventListener('click', function () {
        requestAnimationFrame(sync);
      });
    })();
  </script>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-rule);
    view-transition-name: site-header;
  }

  .site-header__inner {
    width: min(100% - (var(--gutter) * 2), var(--container-max));
    margin-inline: auto;
    height: var(--header-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .site-nav__list {
    display: flex;
    gap: 0.15rem;
  }

  .site-nav__link {
    position: relative;
    display: inline-block;
    padding: var(--space-chip);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: 0.01em;
    color: var(--color-text-soft);
    border-radius: var(--radius-sm);
    transition:
      color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .site-nav__link:hover,
  .site-nav__link:focus-visible {
    color: var(--color-text);
    background: rgb(21 35 32 / 0.04);
  }

  .site-nav__link[aria-current='page'] {
    color: var(--color-primary-strong);
    background: color-mix(in srgb, var(--color-primary) 12%, transparent);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .menu-toggle {
    display: none;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: 0.02em;
    padding: var(--space-chip);
    border-radius: var(--radius-sm);
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .menu-toggle:hover,
  .menu-toggle:focus-visible {
    background: rgb(21 35 32 / 0.04);
  }

  .menu-toggle__close {
    display: none;
  }

  .site-header:has(.site-menu:popover-open) .menu-toggle__open {
    display: none;
  }

  .site-header:has(.site-menu:popover-open) .menu-toggle__close {
    display: inline;
  }

  /* Full-height panel below the header. Overrides the popover UA styles. */
  .site-menu {
    position: fixed;
    inset: var(--header-height) 0 0 0;
    width: 100%;
    height: auto;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-surface);
    color: var(--color-text);
    display: none;
    flex-direction: column;
    justify-content: space-between;
    overflow-y: auto;
  }

  .site-menu:popover-open {
    display: flex;
    animation: menu-in var(--duration-base) var(--ease-out);
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .site-menu__list {
    padding: var(--space-stack) var(--gutter) 0;
  }

  .site-menu__list li {
    border-top: 1px solid var(--color-rule);
  }

  .site-menu__list li:last-child {
    border-bottom: 1px solid var(--color-rule);
  }

  .site-menu__link {
    display: flex;
    align-items: baseline;
    gap: var(--space-5);
    padding: var(--space-4) 0;
  }

  .site-menu__index {
    flex: none;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-caps);
    color: var(--color-primary);
  }

  .site-menu__text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .site-menu__label {
    font-family: var(--font-serif);
    font-weight: var(--weight-heading);
    font-size: clamp(1.75rem, 7vw, 2.4rem);
    line-height: 1.1;
  }

  .site-menu__link[aria-current='page'] .site-menu__label {
    color: var(--color-primary-strong);
  }

  .site-menu__summary {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .site-menu__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5) var(--gutter) var(--space-7);
    border-top: 1px solid var(--color-rule);
    font-size: var(--text-sm);
    color: var(--color-text-soft);
  }

  @media (max-width: 600px) {
    .site-menu__foot {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  .site-menu__talk {
    padding: var(--space-4) var(--gutter) 0;
  }

  .site-menu__talk :global(.btn) {
    width: 100%;
    justify-content: center;
    min-height: 2.75rem;
  }

  @media (max-width: 900px) {
    .site-nav {
      display: none;
    }

    .menu-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 2.75rem;
      min-height: 2.75rem;
    }

    .site-header__actions {
      gap: var(--space-3);
    }
  }

  @media (max-width: 420px) {
    .site-header__actions {
      gap: var(--space-2);
    }
  }

  /* "Conversemos" does not fit beside the wordmark, language switch, and
     menu until about 540px. Below that, the same action is the first control
     in the menu. */
  @media (max-width: 540px) {
    .site-header__actions :global(.btn) {
      display: none;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .site-header,
    .site-menu {
      background: var(--color-surface);
    }
  }

  /* Browsers without the popover API: hide the toggle and show the menu as a
     plain list under the header so navigation still works. */
  @supports not selector(:popover-open) {
    .menu-toggle {
      display: none;
    }

    @media (max-width: 900px) {
      .site-menu {
        position: static;
        display: block;
      }
    }
  }
</style>
