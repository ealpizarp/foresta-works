---
/**
 * One compact section per subscription.
 * Arranque: a page taking shape, grown from a seed.
 * Crecimiento: a canopy spreading from one trunk.
 * Inteligente: roots joined at one node, with a single shoot.
 * Each drawing runs once. Reduced motion shows it finished.
 */
import Button from '@/components/ui/Button.astro';
import { getServiceTiers } from '@/data/services';
import { routes, useI18n } from '@/i18n';

const { locale, t, path } = useI18n(Astro);
const tiers = getServiceTiers(locale);
const detail = t.services.detail;
const contact = path(routes.contacto);
---

{
  tiers.map((tier) => {
    const copy = detail[tier.id];
    return (
      <section
        class:list={['section', 'section--page', 'plan', `plan--${tier.id}`]}
        id={tier.id}
        aria-labelledby={`${tier.id}-title`}
      >
        <div class="container plan__layout">
          <div class="plan__lead">
            <p class="plan__name">{tier.name}</p>
            <h2 class="plan__statement reveal" id={`${tier.id}-title`}>
              {copy.purpose}
            </h2>
            <p class="plan__support reveal">{copy.support}</p>
          </div>

          <figure class="plan__figure" aria-hidden="true">
            {tier.id === 'arranque' && (
              <svg class="plan__draw" viewBox="0 0 320 240" fill="none">
                <ellipse class="plan__ground" cx="168" cy="210" rx="112" ry="14" />
                <g class="plan__emboss" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M152 36 C196 28 238 32 268 40 C286 46 294 62 292 82 V146 C292 164 278 176 260 176 H156 C136 176 126 162 128 142 V86 C128 60 132 44 152 36 Z" />
                  <path d="M150 64 C176 58 206 62 236 58" />
                  <path d="M150 84 C174 88 198 80 224 84" />
                  <path d="M150 102 C168 106 186 98 206 102" />
                  <path d="M232 154 C254 146 272 128 264 108 C248 116 234 134 232 154 Z" />
                  <path d="M62 196 C70 170 88 156 108 146 C120 140 128 134 138 126" />
                  <path d="M96 160 C72 150 52 134 48 116 C68 124 86 142 96 160 Z" />
                </g>
                <g class="plan__ink" stroke-linecap="round" stroke-linejoin="round">
                  <path class="plan__path" pathLength="100" d="M152 36 C196 28 238 32 268 40 C286 46 294 62 292 82 V146 C292 164 278 176 260 176 H156 C136 176 126 162 128 142 V86 C128 60 132 44 152 36 Z" />
                  <path class="plan__path plan__path--later" pathLength="100" d="M150 64 C176 58 206 62 236 58" />
                  <path class="plan__path plan__path--later" pathLength="100" d="M150 84 C174 88 198 80 224 84" />
                  <path class="plan__path plan__path--later" pathLength="100" d="M150 102 C168 106 186 98 206 102" />
                  <path class="plan__path plan__path--last plan__leaf" pathLength="100" d="M232 154 C254 146 272 128 264 108 C248 116 234 134 232 154 Z" />
                  <path class="plan__path plan__path--later" pathLength="100" d="M62 196 C70 170 88 156 108 146 C120 140 128 134 138 126" />
                  <path class="plan__path plan__path--last plan__leaf" pathLength="100" d="M96 160 C72 150 52 134 48 116 C68 124 86 142 96 160 Z" />
                  <circle cx="60" cy="200" r="8" fill="none" stroke="currentColor" stroke-width="1" opacity="0.35" />
                  <circle cx="60" cy="200" r="3.3" fill="currentColor" stroke="none" />
                  <circle class="plan__bud" cx="138" cy="126" r="2.8" fill="currentColor" stroke="none" />
                </g>
              </svg>
            )}

            {tier.id === 'crecimiento' && (
              <svg class="plan__draw" viewBox="0 0 320 240" fill="none">
                <ellipse class="plan__ground" cx="160" cy="214" rx="120" ry="14" />
                <g class="plan__emboss" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M160 202 C158 178 156 156 156 132" />
                  <path d="M156 158 C120 150 84 140 50 122" />
                  <path d="M154 146 C126 124 108 98 96 74" />
                  <path d="M156 132 C152 108 150 86 154 62" />
                  <path d="M158 140 C190 116 216 92 238 66" />
                  <path d="M158 156 C198 148 240 136 276 118" />
                  <path d="M50 122 C26 114 12 94 26 78 C42 90 54 108 50 122 Z" />
                  <path d="M96 74 C78 56 74 34 94 28 C106 44 108 62 96 74 Z" />
                  <path d="M154 64 C134 44 142 20 170 18 C192 24 188 50 154 64 Z" />
                  <path d="M238 66 C258 48 284 50 286 70 C272 78 250 78 238 66 Z" />
                  <path d="M276 118 C298 104 312 114 304 132 C292 136 280 130 276 118 Z" />
                  <path d="M148 114 C124 104 116 84 132 74 C144 88 152 102 148 114 Z" />
                </g>
                <g class="plan__ink" stroke-linecap="round" stroke-linejoin="round">
                  <path class="plan__path" pathLength="100" d="M160 202 C158 178 156 156 156 132" />
                  <path class="plan__path plan__path--later" pathLength="100" d="M156 158 C120 150 84 140 50 122" />
                  <path class="plan__path plan__path--later" pathLength="100" d="M154 146 C126 124 108 98 96 74" />
                  <path class="plan__path" pathLength="100" d="M156 132 C152 108 150 86 154 62" />
                  <path class="plan__path plan__path--later" pathLength="100" d="M158 140 C190 116 216 92 238 66" />
                  <path class="plan__path plan__path--later" pathLength="100" d="M158 156 C198 148 240 136 276 118" />
                  <path class="plan__path plan__path--last plan__leaf" pathLength="100" d="M50 122 C26 114 12 94 26 78 C42 90 54 108 50 122 Z" />
                  <path class="plan__path plan__path--last plan__leaf" pathLength="100" d="M96 74 C78 56 74 34 94 28 C106 44 108 62 96 74 Z" />
                  <path class="plan__path plan__path--last plan__leaf" pathLength="100" d="M154 64 C134 44 142 20 170 18 C192 24 188 50 154 64 Z" />
                  <path class="plan__path plan__path--last plan__leaf" pathLength="100" d="M238 66 C258 48 284 50 286 70 C272 78 250 78 238 66 Z" />
                  <path class="plan__path plan__path--last plan__leaf" pathLength="100" d="M276 118 C298 104 312 114 304 132 C292 136 280 130 276 118 Z" />
                  <path class="plan__path plan__path--last plan__leaf" pathLength="100" d="M148 114 C124 104 116 84 132 74 C144 88 152 102 148 114 Z" />
                  <circle cx="160" cy="206" r="8" fill="none" stroke="currentColor" stroke-width="1" opacity="0.35" />
                  <circle cx="160" cy="206" r="3.3" fill="currentColor" stroke="none" />
                  <circle class="plan__bud plan__bud--clay" cx="170" cy="20" r="3.2" fill="var(--color-clay)" stroke="none" />
                </g>
              </svg>
            )}

            {tier.id === 'inteligente' && (
              <svg class="plan__draw" viewBox="0 0 320 240" fill="none">
                <ellipse class="plan__ground" cx="160" cy="214" rx="118" ry="14" />
                <g class="plan__emboss" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M42 188 C58 166 92 146 128 128 C140 122 148 118 150 116" />
                  <path d="M278 186 C260 164 226 144 192 126 C180 120 172 116 170 114" />
                  <path d="M160 204 C158 180 160 152 160 128" />
                  <path d="M72 158 C112 140 208 140 248 156" />
                  <path d="M64 176 C50 168 42 176 36 188" />
                  <path d="M254 172 C270 164 278 174 284 186" />
                  <path d="M132 156 C118 168 110 182 104 194" />
                  <path d="M188 154 C204 166 212 180 218 192" />
                  <path d="M170 102 C188 86 208 72 230 58" />
                  <path d="M208 76 C224 62 244 60 248 74 C232 80 214 82 208 76 Z" />
                  <circle cx="160" cy="112" r="13" />
                </g>
                <g class="plan__ink" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="160" cy="112" r="13" fill="var(--color-sage-100)" stroke="currentColor" stroke-width="1.25" />
                  <path class="plan__path" pathLength="100" d="M42 188 C58 166 92 146 128 128 C140 122 148 118 150 116" />
                  <path class="plan__path" pathLength="100" d="M278 186 C260 164 226 144 192 126 C180 120 172 116 170 114" />
                  <path class="plan__path" pathLength="100" d="M160 204 C158 180 160 152 160 128" />
                  <path class="plan__path plan__path--later" pathLength="100" d="M72 158 C112 140 208 140 248 156" />
                  <path class="plan__path plan__path--last" pathLength="100" d="M64 176 C50 168 42 176 36 188" />
                  <path class="plan__path plan__path--last" pathLength="100" d="M254 172 C270 164 278 174 284 186" />
                  <path class="plan__path plan__path--last" pathLength="100" d="M132 156 C118 168 110 182 104 194" />
                  <path class="plan__path plan__path--last" pathLength="100" d="M188 154 C204 166 212 180 218 192" />
                  <path class="plan__path plan__path--later" pathLength="100" d="M170 102 C188 86 208 72 230 58" />
                  <path class="plan__path plan__path--last plan__leaf" pathLength="100" d="M208 76 C224 62 244 60 248 74 C232 80 214 82 208 76 Z" />
                  <circle cx="160" cy="112" r="3.2" fill="currentColor" stroke="none" />
                  <circle class="plan__bud plan__bud--clay" cx="234" cy="54" r="3.2" fill="var(--color-clay)" stroke="none" />
                </g>
              </svg>
            )}
          </figure>

          <div class="plan__decision">
            <ul class="plan__points">
              {copy.steps.map((step) => (
                <li class="reveal">{step}</li>
              ))}
            </ul>
            {copy.note && <p class="plan__note">{copy.note}</p>}
            <p class="plan__note">{tier.upgrade}</p>
            <div class="plan__cta">
              <Button href={contact} class="btn--wrap">
                {detail.talk}
                <span class="sr-only"> {tier.name}.</span>
              </Button>
            </div>
          </div>
        </div>
      </section>
    );
  })
}

<style>
  .plan.section--page {
    padding-top: var(--space-5);
    padding-bottom: var(--space-6);
    border-top: 1px solid var(--color-rule);
  }

  .plan__layout {
    display: grid;
    row-gap: var(--space-4);
  }

  .plan__lead {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
  }

  .plan__name {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-lg);
    line-height: 1;
    color: var(--color-primary-strong);
  }

  .plan__statement {
    max-width: 22ch;
    font-size: var(--text-2xl);
    font-weight: var(--weight-display);
    line-height: 1.05;
    letter-spacing: var(--tracking-display);
  }

  .plan__support {
    max-width: 42ch;
    font-size: var(--text-base);
    line-height: 1.5;
    color: var(--color-text-soft);
  }

  .plan__figure {
    margin: 0;
    display: flex;
    justify-content: flex-start;
  }

  .plan__draw {
    display: block;
    width: min(100%, 16rem);
    height: auto;
    overflow: hidden;
    color: var(--color-moss-800);
  }

  .plan__ground {
    fill: var(--color-wash);
  }

  .plan__emboss,
  .plan__ink {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
  }

  .plan__emboss {
    color: var(--color-sage-300);
    opacity: 0.9;
    transform: translate(1.6px, 2px);
  }

  .plan__ink {
    stroke-width: 1.3;
  }

  .plan__leaf {
    fill: var(--color-sage-100);
  }

  .plan__decision {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
  }

  .plan__points {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .plan__points li {
    display: grid;
    grid-template-columns: 0.85rem minmax(0, 1fr);
    column-gap: var(--space-3);
    align-items: start;
    max-width: 46ch;
    font-size: var(--text-base);
    line-height: 1.45;
  }

  .plan__points li::before {
    content: '';
    width: 0.7rem;
    height: 1px;
    margin-top: 0.72em;
    background: var(--color-moss-800);
  }

  .plan__note {
    max-width: 46ch;
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--color-text-soft);
  }

  .plan__cta {
    margin-top: var(--space-2);
  }

  @media (min-width: 900px) {
    .plan__layout {
      grid-template-columns: minmax(0, 1.15fr) minmax(16rem, 0.85fr);
      column-gap: var(--col-gap);
      row-gap: var(--space-4);
      align-items: center;
    }

    .plan__figure {
      grid-column: 2;
      grid-row: 1 / span 2;
      justify-content: center;
    }

    .plan__lead,
    .plan__decision {
      grid-column: 1;
    }

    .plan--crecimiento .plan__layout {
      grid-template-columns: minmax(16rem, 0.85fr) minmax(0, 1.15fr);
    }

    .plan--crecimiento .plan__figure {
      grid-column: 1;
    }

    .plan--crecimiento .plan__lead,
    .plan--crecimiento .plan__decision {
      grid-column: 2;
    }

    .plan__draw {
      width: min(100%, 20rem);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .plan__path {
      stroke-dasharray: 100;
      stroke-dashoffset: 100;
      animation: plan-grow 0.85s var(--ease-out) forwards;
    }

    .plan__path--later {
      animation-duration: 0.7s;
      animation-delay: 0.22s;
    }

    .plan__path--last {
      animation-duration: 0.6s;
      animation-delay: 0.42s;
    }

    .plan__leaf {
      fill: transparent;
      animation: plan-leaf 0.4s var(--ease-out) 0.7s forwards;
    }

    .plan__bud {
      opacity: 0;
      animation: plan-bud 0.35s var(--ease-out) 0.9s forwards;
    }
  }

  @keyframes plan-grow {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes plan-leaf {
    to {
      fill: var(--color-sage-100);
    }
  }

  @keyframes plan-bud {
    to {
      opacity: 1;
    }
  }
</style>
