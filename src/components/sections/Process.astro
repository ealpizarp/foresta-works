---
import { useI18n } from '@/i18n';

const { t } = useI18n(Astro);
---

<section class="section section--page process" aria-labelledby="process-steps-title">
  <div class="container">
    <h2 class="sr-only" id="process-steps-title">{t.process.stepsTitle}</h2>

    <ol class="steps">
      {t.process.steps.map((step, index) => (
        <li class="step reveal">
          <span class="step__num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <h3 class="step__title">{step.title}</h3>
          <p class="step__text">{step.text}</p>
        </li>
      ))}
    </ol>

    <p class="process__note reveal">
      {t.process.note}
    </p>
  </div>
</section>

<style>
  .steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--col-gap);
  }

  .steps::before {
    content: '';
    position: absolute;
    top: 1.15rem;
    left: 2%;
    right: 2%;
    height: 1px;
    background: var(--color-rule-strong);
    pointer-events: none;
  }

  .step {
    position: relative;
  }

  .step__num {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.35rem;
    height: 2.35rem;
    border-radius: var(--radius-pill);
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }

  .step__title {
    margin-top: var(--space-3);
    font-size: var(--text-xl);
    line-height: 1.15;
  }

  .step__text {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--color-text-soft);
    padding-right: var(--space-2);
  }

  .process__note {
    margin-top: var(--space-section-gap);
    font-family: var(--font-serif);
    font-weight: var(--weight-heading);
    font-size: var(--text-lg);
    line-height: 1.35;
    max-width: 44ch;
  }

  @media (max-width: 1100px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
    }

    .steps::before {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
