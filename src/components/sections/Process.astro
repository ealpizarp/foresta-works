---
import ProcessField from '@/components/visuals/ProcessField.astro';
import { useI18n } from '@/i18n';

const { t } = useI18n(Astro);
---

<section class="section section--page process" aria-labelledby="process-steps-title">
  <div class="container">
    <h2 class="sr-only" id="process-steps-title">{t.process.stepsTitle}</h2>

    <ProcessField steps={t.process.steps} />

    <p class="process__note reveal">
      {t.process.note}
    </p>
  </div>
</section>

<style>
  .process__note {
    margin-top: var(--space-section-gap);
    font-family: var(--font-serif);
    font-weight: var(--weight-heading);
    font-size: var(--text-lg);
    line-height: 1.35;
    max-width: 44ch;
  }
</style>
