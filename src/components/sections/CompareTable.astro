---
/**
 * Comparison matrix for the three plans. Marks are written out, not just
 * icons, so the table stays clear without color and works for screen readers.
 */
import { compareMarkSymbol, comparisonMarks, getServiceTiers } from '@/data/services';
import { useI18n } from '@/i18n';

const { locale, t } = useI18n(Astro);
const tiers = getServiceTiers(locale);
---

<section class="section section--page compare" aria-labelledby="compare-title">
  <div class="container">
    <div class="compare__intro">
      <h2 class="compare__title" id="compare-title">{t.services.compareTitle}</h2>
      <p class="compare__lede">{t.services.compareLede}</p>
    </div>

    <div class="compare__scroll panel">
      <table class="compare__table">
        <caption class="sr-only">{t.services.compareCaption}</caption>
        <colgroup>
          <col class="compare__col-label" />
          {
            tiers.map((tier) => (
              <col class:list={{ 'is-featured': Boolean(tier.recommended) }} />
            ))
          }
        </colgroup>
        <thead>
          <tr>
            <th scope="col">{t.services.compareColumn}</th>
            {tiers.map((tier) => (
              <th scope="col" class:list={{ 'is-featured': Boolean(tier.recommended) }}>{tier.name}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {comparisonMarks.map((row) => (
            <tr>
              <th scope="row">{t.services.compareRows[row.key]}</th>
              {(['arranque', 'crecimiento', 'inteligente'] as const).map((key) => {
                const mark = row[key];
                const featured = key === 'crecimiento';
                return (
                  <td data-mark={mark} class:list={{ 'is-featured': featured }}>
                    <span class="compare__mark" aria-hidden="true">
                      {compareMarkSymbol[mark]}
                    </span>
                    {t.services.compareMarks[mark]}
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="compare__pick">
      <div class="compare__tabs" role="radiogroup" aria-label={t.services.compareTitle}>
        {
          tiers.map((tier) => (
            <label class="compare__tab">
              <input
                type="radio"
                name="compare-plan"
                value={tier.id}
                checked={Boolean(tier.recommended)}
              />
              <span>{tier.name}</span>
              {tier.badge && <span class="sr-only">, {tier.badge}</span>}
            </label>
          ))
        }
      </div>
      <ul class="compare__rows">
        {
          comparisonMarks.map((row) => (
            <li>
              <p class="compare__feature">{t.services.compareRows[row.key]}</p>
              {
                tiers.map((tier) => {
                  const mark = row[tier.id];
                  return (
                    <p class="compare__status" data-plan={tier.id} data-mark={mark}>
                      <span class="compare__mark" aria-hidden="true">
                        {compareMarkSymbol[mark]}
                      </span>
                      {t.services.compareMarks[mark]}
                    </p>
                  );
                })
              }
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .compare__intro {
    max-width: 38rem;
    margin-bottom: var(--space-7);
  }

  .compare__title {
    font-size: var(--text-2xl);
    line-height: var(--leading-snug);
  }

  .compare__lede {
    margin-top: var(--space-4);
    font-size: var(--text-md);
    color: var(--color-text-soft);
  }

  .compare__scroll {
    overflow-x: auto;
    padding: var(--space-inset-lg);
  }

  .compare__table {
    width: 100%;
    min-width: 36rem;
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: 0;
    font-size: var(--text-sm);
  }

  .compare__col-label {
    width: 32%;
  }

  .compare__table col:not(.compare__col-label) {
    width: 22.666%;
  }

  .compare__table th,
  .compare__table td {
    padding: var(--space-4) var(--space-5);
    text-align: left;
    vertical-align: middle;
    border-bottom: 1px solid var(--color-rule);
  }

  .compare__table thead th:first-child,
  .compare__table tbody th {
    padding-left: 0;
    font-weight: var(--weight-medium);
    color: var(--color-text);
  }

  .compare__table thead th {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
    padding-top: var(--space-4);
    padding-bottom: var(--space-4);
  }

  .compare__table td {
    color: var(--color-text-soft);
  }

  .compare__table .is-featured {
    background: color-mix(in srgb, var(--color-sage-100) 72%, var(--color-surface));
  }

  .compare__table thead th.is-featured {
    color: var(--color-primary-strong);
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
  }

  .compare__table tbody tr:last-child td.is-featured {
    border-radius: 0 0 var(--radius-sm) var(--radius-sm);
  }

  .compare__table tbody tr:hover th,
  .compare__table tbody tr:hover td:not(.is-featured) {
    background: rgb(12 92 82 / 0.05);
  }

  .compare__mark {
    display: inline-block;
    width: 1.1rem;
    color: var(--color-primary);
    font-size: 0.65rem;
    line-height: 1;
  }

  .compare__table td[data-mark='no'] .compare__mark {
    color: var(--color-text-muted);
  }

  .compare__table td[data-mark='extra'] .compare__mark {
    color: var(--color-primary);
  }

  .compare__table tbody tr:last-child th,
  .compare__table tbody tr:last-child td {
    border-bottom: 0;
  }

  .compare__pick {
    display: none;
  }

  .compare__tabs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding: 0.16rem;
    border: 1px solid var(--color-rule-strong);
    border-radius: var(--radius-md);
  }

  .compare__tab {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: var(--space-2) var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    line-height: 1.2;
    text-align: center;
    color: var(--color-text-soft);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .compare__tab input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    border: 0;
  }

  .compare__tab:has(input:checked) {
    color: var(--color-on-primary);
    background: var(--color-primary);
  }

  .compare__tab:has(input:focus-visible) {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .compare__rows {
    margin-top: var(--space-4);
    border-top: 1px solid var(--color-rule);
  }

  .compare__rows li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-3);
    align-items: baseline;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-rule);
  }

  .compare__feature {
    max-width: none;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    line-height: 1.35;
    color: var(--color-text);
  }

  .compare__status {
    display: none;
    max-width: none;
    font-size: var(--text-sm);
    line-height: 1.3;
    color: var(--color-text-soft);
    text-align: right;
    white-space: nowrap;
  }

  .compare__pick:has(input[value='arranque']:checked) .compare__status[data-plan='arranque'],
  .compare__pick:has(input[value='crecimiento']:checked) .compare__status[data-plan='crecimiento'],
  .compare__pick:has(input[value='inteligente']:checked) .compare__status[data-plan='inteligente'] {
    display: block;
  }

  .compare__status .compare__mark {
    width: 0.9rem;
  }

  .compare__status[data-mark='no'],
  .compare__status[data-mark='no'] .compare__mark {
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .compare__scroll {
      display: none;
    }

    .compare__pick {
      display: block;
    }
  }

  @media (max-width: 600px) {
    .compare__scroll {
      padding: var(--space-4);
    }

    .compare__table th,
    .compare__table td {
      padding: var(--space-3);
    }
  }
</style>
