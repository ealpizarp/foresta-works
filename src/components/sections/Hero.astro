---
/**
 * One headline, one supporting sentence, one primary action.
 * The root field is a quiet map of the work: site, light automation, care.
 * It stays secondary to the invitation.
 */
import Button from '@/components/ui/Button.astro';
import RootField from '@/components/visuals/RootField.astro';
import { whatsappUrl } from '@/data/site';
import { routes, useI18n } from '@/i18n';

const { t, path } = useI18n(Astro);
const whatsapp = whatsappUrl(t.meta.whatsappMessage);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__layout">
    <div class="hero__copy">
      <h1 class="hero__title" id="hero-title">
        {t.hero.title}
        {' '}
        <em>{t.hero.titleEm}</em>
      </h1>
      <p class="hero__lede">{t.hero.lede}</p>
      <div class="hero__actions">
        {whatsapp !== null ? (
          <Button href={whatsapp} external>{t.hero.writeWhatsApp}</Button>
        ) : (
          <Button href={path(routes.contacto)}>{t.hero.startConversation}</Button>
        )}
      </div>
    </div>

    <div class="hero__field" data-sway aria-hidden="true">
      <RootField site={t.hero.cueSite} auto={t.hero.cueAuto} care={t.hero.cueCare} />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow-x: clip;
    padding-top: var(--space-page);
    padding-bottom: var(--space-section-gap);
  }

  /* Dappled canopy light, kept off the type. */
  .hero::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0 0 auto 0;
    height: 72%;
    pointer-events: none;
    background:
      radial-gradient(ellipse 9rem 6rem at 18% 18%, rgb(255 250 243 / 0.9), transparent 72%),
      radial-gradient(ellipse 8rem 5rem at 72% 22%, rgb(197 212 196 / 0.45), transparent 70%),
      radial-gradient(ellipse 7rem 5rem at 84% 62%, rgb(143 216 203 / 0.22), transparent 72%);
  }

  .hero__layout {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-8);
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 38rem;
  }

  .hero__title {
    font-size: clamp(2.5rem, 9vw, 3.4rem);
    font-weight: var(--weight-display);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
    max-width: 14ch;
    text-wrap: balance;
  }

  .hero__title em {
    display: block;
    font-style: italic;
    font-weight: var(--weight-heading);
    color: var(--color-clay);
  }

  .hero__lede {
    margin-top: var(--space-6);
    max-width: 34ch;
    font-size: var(--text-lg);
    font-weight: var(--weight-medium);
    line-height: 1.35;
    color: var(--color-text);
    text-wrap: pretty;
  }

  .hero__actions {
    margin-top: var(--space-7);
  }

  .hero__field {
    width: min(100%, 22.5rem);
    color: var(--color-moss-800);
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      translate: 0 0.7rem;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__title,
    .hero__lede,
    .hero__actions {
      animation: hero-in var(--duration-slow) var(--ease-out) both;
    }

    .hero__lede { animation-delay: 0.12s; }
    .hero__actions { animation-delay: 0.24s; }

    .hero__field {
      animation: hero-in 1.15s var(--ease-out) 0.12s both;
    }
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .hero::before {
      translate: calc(var(--px, 0) * 0.65rem) calc(var(--py, 0) * 0.4rem);
      transition: translate 1.35s var(--ease-out);
    }
  }

  @media (max-width: 600px) {
    .hero {
      padding-top: var(--space-7);
      padding-bottom: var(--space-6);
    }

    .hero__layout {
      gap: var(--space-6);
    }

    .hero__lede {
      margin-top: var(--space-4);
    }

    .hero__actions {
      margin-top: var(--space-5);
    }
  }

  @media (min-width: 1000px) {
    .hero__layout {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(18rem, 0.9fr);
      column-gap: clamp(3rem, 6vw, 6.5rem);
      align-items: center;
      gap: 0;
    }

    .hero__copy {
      grid-column: 1;
      max-width: 34rem;
    }

    .hero__field {
      grid-column: 2;
      width: min(100%, 32rem);
      margin-left: 0;
      justify-self: end;
    }

    .hero__title {
      font-size: clamp(2.9rem, 3.5vw, 4rem);
      max-width: 16ch;
    }

    .hero__lede {
      max-width: 32ch;
    }
  }
</style>
