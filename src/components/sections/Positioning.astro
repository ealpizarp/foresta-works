---
/**
 * Photo: Unsplash License (https://unsplash.com/license), stored locally.
 * Illustrative small-business scene — not a Foresta client.
 */
import { Image } from 'astro:assets';
import paymentImage from '@/assets/images/shop-payment.jpg';
import { useI18n } from '@/i18n';

const { t } = useI18n(Astro);

/** Short branches off the audience trunk. Cycled so the list is one tree, not a stamp. */
const twigs = [
  { main: 'M2 18 C 18 18 32 11 50 14', fork: 'M28 13 C 34 5 42 4 48 8', cx: 54, cy: 14 },
  { main: 'M2 14 C 16 16 34 22 50 16', fork: 'M22 18 C 16 26 10 28 6 24', cx: 54, cy: 16 },
  { main: 'M2 16 C 20 15 36 18 50 15', fork: 'M30 16 C 36 8 44 7 50 11', cx: 54, cy: 15 },
];

/**
 * One root through the four outcomes. Each span meets the next bud;
 * the sag is uneven so it reads as a root, not a garland. The emboss
 * sits just under the moss line. Hairs stay off the stretched runs;
 * a stretched fork turns into a speck.
 */
const outcomeSpans = [
  {
    line: 'M0 0 C 46 2, 72 30, 104 32 C 136 34, 168 4, 200 0',
    emboss: 'M0 5 C 46 7, 72 35, 104 37 C 136 39, 168 9, 200 5',
  },
  {
    line: 'M0 0 C 36 0, 70 22, 108 24 C 142 26, 172 3, 200 0',
    emboss: 'M0 5 C 36 5, 70 27, 108 29 C 142 31, 172 8, 200 5',
  },
  {
    line: 'M0 0 C 58 1, 90 28, 122 30 C 150 32, 176 4, 200 0',
    emboss: 'M0 5 C 58 6, 90 33, 122 35 C 150 37, 176 9, 200 5',
  },
];

/** Upright stem between buds when the four stack. Alternates lean. */
const outcomeDrops = [
  { line: 'M9 0 C 5 28, 13 56, 9 80', emboss: 'M12 2 C 8 30, 16 58, 12 80' },
  { line: 'M9 0 C 13 26, 5 54, 9 80', emboss: 'M6 2 C 10 28, 2 56, 6 80' },
];
---

<section class="section positioning" aria-labelledby="positioning-title">
  <div class="container positioning__grid">
    <p class="eyebrow positioning__eyebrow reveal">
      <span class="eyebrow__num">01</span>
      {t.positioning.eyebrow}
    </p>

    <h2 class="positioning__statement reveal" id="positioning-title">
      {t.positioning.statement}
      {' '}
      <em>{t.positioning.statementEm}</em>
    </h2>

    <div class="positioning__body reveal">
      <p class="positioning__aside">{t.positioning.p1}</p>
      <p>{t.positioning.p2}</p>
      <p class="positioning__aside">{t.positioning.p3}</p>
    </div>

    <aside class="positioning__index reveal" aria-labelledby="positioning-audience">
      <h3 class="label positioning__index-title" id="positioning-audience">{t.positioning.audienceTitle}</h3>
      <ul class="positioning__index-list">
        <svg class="positioning__trunk" viewBox="0 0 40 220" preserveAspectRatio="none" fill="none" aria-hidden="true">
          <circle cx="31" cy="5" r="2.5" fill="currentColor" />
          <path d="M31 9 C 34 38 26 62 31 92 C 36 124 25 154 31 186 C 33 202 30 212 31 218" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" vector-effect="non-scaling-stroke" />
          <path d="M30 36 C 18 28 10 22 4 14" stroke="currentColor" stroke-width="1.05" stroke-linecap="round" vector-effect="non-scaling-stroke" />
          <path d="M29 96 C 16 104 10 116 8 128" stroke="currentColor" stroke-width="1.05" stroke-linecap="round" vector-effect="non-scaling-stroke" />
          <path d="M31 156 C 18 148 10 140 4 132" stroke="currentColor" stroke-width="1.05" stroke-linecap="round" vector-effect="non-scaling-stroke" />
          <path d="M30 198 C 18 206 12 212 8 216" stroke="currentColor" stroke-width="1" stroke-linecap="round" vector-effect="non-scaling-stroke" />
        </svg>
        {t.positioning.audiences.map((audience, index) => {
          const twig = twigs[index % twigs.length] ?? twigs[0];
          if (!twig) return null;
          return (
            <li>
              <svg class="positioning__twig" viewBox="0 0 64 32" fill="none" aria-hidden="true">
                <path d={twig.main} stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
                <path d={twig.fork} stroke="currentColor" stroke-width="1.05" stroke-linecap="round" />
                <circle cx={twig.cx} cy={twig.cy} r="2.3" fill="none" stroke="var(--color-clay)" stroke-width="1.25" />
              </svg>
              <span>{audience}</span>
            </li>
          );
        })}
      </ul>
    </aside>

    <figure class="positioning__figure frame reveal">
      <Image
        src={paymentImage}
        alt={t.positioning.photoAlt}
        layout="constrained"
        width={864}
        height={1152}
        widths={[420, 640, 864]}
        sizes="(min-width: 1100px) 28vw, (min-width: 900px) 40vw, 70vw"
        loading="lazy"
      />
    </figure>
  </div>

  <div class="container">
    <div class="outcomes-system reveal">
      <ol class="outcomes" aria-label={t.positioning.outcomesLabel}>
        {t.positioning.outcomes.map((outcome, index) => {
          const last = index === t.positioning.outcomes.length - 1;
          const span = outcomeSpans[index];
          const drop = outcomeDrops[index % outcomeDrops.length];
          return (
            <li class="outcomes__item">
              <svg class="outcomes__node" viewBox="0 0 16 16" width="18" height="18" fill="none" aria-hidden="true">
                <circle cx="8" cy="8" r="5.25" stroke="currentColor" stroke-width="1.25" />
                <circle cx="8" cy="8" r="2.1" fill="var(--color-clay)" />
              </svg>
              {!last && span && (
                <svg class="outcomes__span" viewBox="0 0 200 48" preserveAspectRatio="none" overflow="visible" fill="none" aria-hidden="true">
                  <path class="outcomes__emboss" d={span.emboss} stroke="var(--color-sage-300)" stroke-width="1.15" stroke-linecap="round" />
                  <path class="outcomes__path" pathLength="100" d={span.line} stroke="currentColor" stroke-width="1.45" stroke-linecap="round" />
                </svg>
              )}
              {last && (
                <svg class="outcomes__span outcomes__span--tail" viewBox="0 0 76 28" overflow="visible" fill="none" aria-hidden="true">
                  <path class="outcomes__emboss" d="M0 4 C 20 5, 40 8, 64 16" stroke="var(--color-sage-300)" stroke-width="1.15" stroke-linecap="round" />
                  <path class="outcomes__path" pathLength="100" d="M0 0 C 18 1, 38 4, 62 14" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
                  <path class="outcomes__hair" pathLength="100" d="M36 2 C 44 -5, 56 -7, 64 0" stroke="currentColor" stroke-width="1.05" stroke-linecap="round" />
                </svg>
              )}
              {!last && drop && (
                <svg class="outcomes__drop" viewBox="0 0 18 80" preserveAspectRatio="none" fill="none" aria-hidden="true">
                  <path class="outcomes__emboss" d={drop.emboss} stroke="var(--color-sage-300)" stroke-width="1.15" stroke-linecap="round" />
                  <path class="outcomes__path" pathLength="100" d={drop.line} stroke="currentColor" stroke-width="1.35" stroke-linecap="round" />
                </svg>
              )}
              <div class="outcomes__note">
                <span class="outcomes__join" aria-hidden="true"></span>
                <span class="outcomes__num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <p>{outcome}</p>
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </div>
</section>

<style>
  .positioning__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--col-gap);
    row-gap: var(--space-section-gap);
    align-items: start;
  }

  .positioning__eyebrow {
    grid-column: 1 / -1;
  }

  .positioning__statement {
    grid-column: 1 / 9;
    font-size: var(--text-3xl);
    line-height: var(--leading-snug);
  }

  .positioning__statement em {
    font-style: italic;
    font-weight: var(--weight-heading);
    color: var(--color-clay);
  }

  .positioning__body {
    grid-column: 1 / 6;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    color: var(--color-text-soft);
  }

  .positioning__body p {
    max-width: 48ch;
  }

  .positioning__index {
    grid-column: 7 / 10;
  }

  .positioning__index-title {
    margin-bottom: var(--space-3);
  }

  /* One trunk, a short branch into each audience. The drawing stays in the gutter. */
  .positioning__index-list {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding-left: 1.15rem;
  }

  .positioning__trunk {
    position: absolute;
    left: 0;
    top: 0.15rem;
    width: 1.35rem;
    height: calc(100% - 0.3rem);
    color: var(--color-moss-800);
    opacity: 0.62;
    pointer-events: none;
  }

  .positioning__index-list li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 1.85rem;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    line-height: 1.3;
    color: var(--color-text);
  }

  .positioning__twig {
    flex: none;
    width: 1.7rem;
    height: 1.15rem;
    margin-left: -0.15rem;
    color: var(--color-moss-800);
    opacity: 0.75;
    pointer-events: none;
  }

  .positioning__figure {
    grid-column: 10 / 13;
    grid-row: 2 / 4;
    align-self: start;
    border-radius: var(--radius-leaf);
    box-shadow: var(--shadow-leaf);
  }

  .positioning__figure img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: 58% 42%;
  }

  /* Outcomes. One root, four buds. Each sentence sits on a paper
     note, joined to its bud by a short moss stem. */
  .outcomes-system {
    margin-top: var(--space-section-gap);
  }

  .outcomes {
    --node: 1.15rem;
    --stem: 0.75rem;
    --outcomes-pad: 0px;
    --root-y: calc(var(--outcomes-pad) + var(--node) / 2);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: var(--col-gap);
    margin: 0;
    padding: 0;
    min-width: 0;
  }

  .outcomes__item {
    position: relative;
    display: grid;
    grid-template-columns: var(--node) minmax(0, 1fr);
    column-gap: 0.45rem;
    row-gap: var(--stem);
    align-items: start;
    align-content: start;
    min-width: 0;
    padding-top: var(--outcomes-pad);
    background: none;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

  .outcomes__node,
  .outcomes__span,
  .outcomes__drop {
    color: var(--color-moss-800);
  }

  .outcomes__node {
    position: relative;
    z-index: 1;
    grid-column: 1;
    grid-row: 1;
    width: var(--node);
    height: var(--node);
  }

  .outcomes__span,
  .outcomes__drop {
    position: absolute;
    z-index: 0;
    overflow: visible;
    pointer-events: none;
  }

  .outcomes__span {
    left: calc(var(--node) / 2);
    top: var(--root-y);
    width: calc(100% + var(--col-gap));
    height: 1.15rem;
  }

  .outcomes__span--tail {
    width: 4.75rem;
    height: 1.75rem;
  }

  .outcomes__drop {
    display: none;
    left: 0;
    top: var(--root-y);
    width: var(--node);
    height: 100%;
  }

  .outcomes__note {
    position: relative;
    z-index: 1;
    grid-column: 1 / -1;
    grid-row: 2;
    min-width: 0;
    padding: 0.7rem 0.85rem 0.8rem;
    background: var(--color-paper);
    border: 1px solid var(--color-rule-strong);
    border-radius: 0.7rem;
    border-top-left-radius: 0.15rem;
    box-shadow: var(--shadow-sm);
  }

  .outcomes__join {
    position: absolute;
    z-index: 0;
    left: calc(var(--node) / 2 - 0.75px);
    bottom: 100%;
    width: 1.5px;
    height: var(--stem);
    background: var(--color-moss-800);
    pointer-events: none;
  }

  .outcomes__num {
    display: block;
    margin: 0 0 0.4rem;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-caps);
    line-height: 1;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .outcomes__note p {
    margin: 0;
    min-width: 0;
    max-width: none;
    font-family: var(--font-serif);
    font-weight: var(--weight-heading);
    font-size: var(--text-md);
    line-height: 1.28;
    text-wrap: pretty;
  }

  /* Notes arrive once. The root is already the finished drawing;
     a clip on the stretched stroke was hiding the sag. */
  @media (prefers-reduced-motion: no-preference) {
    .outcomes-system:not(.reveal--wait) .outcomes__note,
    .outcomes-system.reveal--wait.is-in .outcomes__note {
      animation: outcomes-note 0.65s var(--ease-out) both;
    }

    .outcomes-system:not(.reveal--wait) .outcomes__item:nth-child(2) .outcomes__note,
    .outcomes-system.reveal--wait.is-in .outcomes__item:nth-child(2) .outcomes__note {
      animation-delay: 0.16s;
    }

    .outcomes-system:not(.reveal--wait) .outcomes__item:nth-child(3) .outcomes__note,
    .outcomes-system.reveal--wait.is-in .outcomes__item:nth-child(3) .outcomes__note {
      animation-delay: 0.32s;
    }

    .outcomes-system:not(.reveal--wait) .outcomes__item:nth-child(4) .outcomes__note,
    .outcomes-system.reveal--wait.is-in .outcomes__item:nth-child(4) .outcomes__note {
      animation-delay: 0.48s;
    }
  }

  @keyframes outcomes-note {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @media (max-width: 1100px) {
    .positioning__statement {
      grid-column: 1 / 10;
    }

    .positioning__body {
      grid-column: 1 / 7;
    }

    .positioning__index {
      grid-column: 8 / 11;
    }

    .positioning__figure {
      grid-column: 11 / 13;
      grid-row: 3;
    }
  }

  @media (max-width: 900px) {
    .positioning__statement {
      grid-column: 1 / -1;
    }

    .positioning__body {
      grid-column: 1 / 8;
    }

    .positioning__aside {
      display: none;
    }

    .positioning__index {
      grid-column: 9 / 13;
    }

    .positioning__figure {
      display: none;
    }

    .outcomes {
      --outcomes-pad: 0px;
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0;
    }

    .outcomes__item {
      column-gap: var(--stem);
      row-gap: 0;
      padding-top: 0;
      padding-bottom: var(--space-5);
      align-items: start;
    }

    .outcomes__item:last-child {
      padding-bottom: 0;
    }

    .outcomes__span {
      display: none;
    }

    .outcomes__drop {
      display: block;
    }

    .outcomes__note {
      grid-column: 2;
      grid-row: 1;
      border-top-left-radius: 0.15rem;
    }

    .outcomes__join {
      left: calc((var(--stem) + var(--node) / 2) * -1);
      bottom: auto;
      top: calc(var(--node) / 2 - 0.75px);
      width: calc(var(--stem) + var(--node) / 2);
      height: 1.5px;
    }
  }

  @media (max-width: 600px) {
    .positioning__body,
    .positioning__index {
      grid-column: 1 / -1;
    }
  }
</style>
