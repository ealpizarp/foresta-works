---
/**
 * Photo: Unsplash License (https://unsplash.com/license), stored locally.
 * Illustrative small-business scene — not a Foresta client.
 */
import { Image } from 'astro:assets';
import paymentImage from '@/assets/images/shop-payment.jpg';
import { useI18n } from '@/i18n';

const { t } = useI18n(Astro);
---

<section class="section positioning" aria-labelledby="positioning-title">
  <div class="container positioning__grid">
    <p class="eyebrow positioning__eyebrow reveal">
      <span class="eyebrow__num">01</span>
      {t.positioning.eyebrow}
    </p>

    <h2 class="positioning__statement reveal" id="positioning-title">
      {t.positioning.statement}
      {' '}
      <em>{t.positioning.statementEm}</em>
    </h2>

    <div class="positioning__body reveal">
      <p>{t.positioning.p1}</p>
      <p>{t.positioning.p2}</p>
      <p>{t.positioning.p3}</p>
    </div>

    <aside class="positioning__index reveal" aria-labelledby="positioning-audience">
      <h3 class="label positioning__index-title" id="positioning-audience">{t.positioning.audienceTitle}</h3>
      <ul class="positioning__index-list">
        {t.positioning.audiences.map((audience) => <li class="chip">{audience}</li>)}
      </ul>
    </aside>

    <figure class="positioning__figure frame reveal">
      <Image
        src={paymentImage}
        alt={t.positioning.photoAlt}
        layout="constrained"
        width={864}
        height={1152}
        widths={[420, 640, 864]}
        sizes="(min-width: 1100px) 28vw, (min-width: 900px) 40vw, 70vw"
        loading="lazy"
      />
    </figure>
  </div>

  <div class="container">
    <ol class="outcomes" aria-label={t.positioning.outcomesLabel}>
      {t.positioning.outcomes.map((outcome, index) => (
        <li class="outcomes__item panel reveal">
          <span class="outcomes__num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <p>{outcome}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .positioning__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--col-gap);
    row-gap: var(--space-section-gap);
    align-items: start;
  }

  .positioning__eyebrow {
    grid-column: 1 / -1;
  }

  .positioning__statement {
    grid-column: 1 / 9;
    font-size: var(--text-3xl);
    line-height: var(--leading-snug);
  }

  .positioning__statement em {
    font-style: italic;
    font-weight: var(--weight-heading);
    color: var(--color-clay);
  }

  .positioning__body {
    grid-column: 1 / 6;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    color: var(--color-text-soft);
  }

  .positioning__body p {
    max-width: 48ch;
  }

  .positioning__index {
    grid-column: 7 / 10;
  }

  .positioning__index-title {
    margin-bottom: var(--space-4);
  }

  .positioning__index-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .positioning__index-list li {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .positioning__figure {
    grid-column: 10 / 13;
    grid-row: 2 / 4;
    align-self: start;
    border-radius: var(--radius-xl);
  }

  .positioning__figure img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: 58% 42%;
  }

  /* Outcomes strip */
  .outcomes {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--col-gap);
    margin-top: var(--space-section-gap);
  }

  .outcomes__item {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-inset-lg);
  }

  .outcomes__num {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-caps);
    color: var(--color-clay);
    font-variant-numeric: tabular-nums;
  }

  .outcomes__item p {
    font-family: var(--font-serif);
    font-weight: var(--weight-heading);
    font-size: var(--text-lg);
    line-height: 1.3;
  }

  @media (max-width: 1100px) {
    .positioning__statement {
      grid-column: 1 / 10;
    }

    .positioning__body {
      grid-column: 1 / 7;
    }

    .positioning__index {
      grid-column: 8 / 11;
    }

    .positioning__figure {
      grid-column: 11 / 13;
      grid-row: 3;
    }
  }

  @media (max-width: 900px) {
    .positioning__statement {
      grid-column: 1 / -1;
    }

    .positioning__body {
      grid-column: 1 / 8;
    }

    .positioning__index {
      grid-column: 9 / 13;
    }

    .positioning__figure {
      grid-column: 7 / 13;
      grid-row: auto;
    }

    .outcomes {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .positioning__body,
    .positioning__index {
      grid-column: 1 / -1;
    }

    .positioning__figure {
      grid-column: 3 / 13;
    }

    .outcomes {
      grid-template-columns: 1fr;
    }
  }
</style>
