---
/** Full detail of the three subscription plans, then billing notes and scope. */
import Button from '@/components/ui/Button.astro';
import InterfacePreview from '@/components/visuals/InterfacePreview.astro';
import { getServiceTiers } from '@/data/services';
import { routes, useI18n } from '@/i18n';

const previewKind = {
  arranque: 'site',
  crecimiento: 'shop',
  inteligente: 'chat',
} as const;

const { locale, t, path } = useI18n(Astro);
const tiers = getServiceTiers(locale);
---

<section class="section section--page tiers-section" aria-labelledby="tiers-title">
  <div class="container">
    <h2 class="sr-only" id="tiers-title">{t.services.plansTitle}</h2>

    <ol class="tiers">
      {tiers.map((tier, index) => (
        <li class:list={['tier', 'panel', 'reveal', { 'tier--featured': tier.recommended }]} id={tier.id}>
          <div class="tier__preview">
            <InterfacePreview kind={previewKind[tier.id]} size="card" />
          </div>
          <header class="tier__head">
            <div class="tier__meta">
              <span class="tier__num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              {tier.badge && <span class="tier__badge">{tier.badge}</span>}
            </div>
            <h3 class="tier__name">{tier.name}</h3>
            <p class="tier__audience">{tier.audience}</p>
            <p class="tier__price">
              <span class="tier__price-amount">{t.services.monthly}</span>
              <span class="tier__price-period">{t.services.monthlyWritten}</span>
            </p>
            <p class="tier__setup">
              <span>{t.services.oneTimeBuild}</span>
              <span class="tier__setup-note">{t.services.oneTimeBuildWritten}</span>
            </p>
            <p class="tier__desc">{tier.description}</p>
          </header>

          <div class="tier__includes">
            <h4 class="label">{t.services.monthlyHeading}</h4>
            <ul>
              {tier.monthlyIncludes.map((item) => <li>{item}</li>)}
            </ul>
          </div>

          <div class="tier__includes">
            <h4 class="label">{t.services.buildHeading}</h4>
            <ul>
              {tier.setupIncludes.map((item) => <li>{item}</li>)}
            </ul>
          </div>

          <div class="tier__includes">
            <h4 class="label">{t.services.billedApart}</h4>
            <ul>
              {tier.billedSeparately.map((item) => <li>{item}</li>)}
            </ul>
          </div>

          <p class="tier__upgrade">{tier.upgrade}</p>

          <p class="tier__outcome">
            <span class="label">{t.services.outcomeLabel}</span>
            <span class="tier__outcome-text">{tier.outcome}</span>
          </p>

          <div class="tier__cta">
            <Button href={path(routes.contacto)} variant={tier.recommended ? 'primary' : 'outline'} size="sm">
              {t.services.wantPlan}
            </Button>
          </div>
        </li>
      ))}
    </ol>

    <div class="tiers-foot">
      <div class="tiers-foot__pricing panel reveal">
        <h3 class="label tiers-foot__label">{t.services.howBilled}</h3>
        <p>{t.services.currencyNote}</p>
        <p>{t.services.billing}</p>
        <p>{t.services.adSpend}</p>
        <p>{t.services.upgradeNote}</p>
      </div>
      <div class="tiers-foot__scope panel reveal">
        <h3 class="label tiers-foot__label">{t.services.whatWeDont}</h3>
        <p>{t.services.whatWeDontBody}</p>
        <ul class="tiers-foot__list">
          {t.services.notOffered.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .tiers {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--col-gap);
    align-items: stretch;
  }

  .tier {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--space-inset-lg);
    overflow: hidden;
    scroll-margin-top: calc(var(--header-height) + 1rem);
    border-radius: var(--radius-lg);
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .tier--featured {
    border-radius: var(--radius-leaf);
    border-color: var(--color-clay);
  }

  .tier:not(.tier--featured):hover {
    border-color: var(--color-primary);
  }

  .tier__preview {
    margin: calc(var(--space-inset-lg) * -1) calc(var(--space-inset-lg) * -1) var(--space-5);
    padding: var(--space-4);
    background: var(--color-stage);
  }

  .tier__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .tier__num {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-caps);
    color: var(--color-primary);
    font-variant-numeric: tabular-nums;
  }

  .tier__badge {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-on-primary);
    background: var(--color-primary);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
  }

  .tier__name {
    margin-top: var(--space-5);
    font-size: var(--text-2xl);
    line-height: 1.1;
  }

  .tier__audience {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-primary-strong);
  }

  .tier__price {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .tier__price-amount {
    font-family: var(--font-serif);
    font-weight: var(--weight-heading);
    font-size: var(--text-2xl);
    line-height: 1;
    letter-spacing: var(--tracking-display);
    font-variant-numeric: tabular-nums;
  }

  .tier__price-period {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .tier__setup {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-soft);
  }

  .tier__setup-note {
    font-weight: var(--weight-body);
    color: var(--color-text-muted);
  }

  .tier__desc {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-soft);
  }

  .tier__includes {
    margin-top: var(--space-6);
  }

  .tier__includes ul {
    margin-top: var(--space-3);
  }

  .tier__includes li {
    font-size: var(--text-sm);
    line-height: 1.45;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-rule);
  }

  .tier__includes li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .tier__upgrade {
    margin-top: var(--space-5);
    font-size: var(--text-sm);
    color: var(--color-text-soft);
  }

  .tier__outcome {
    display: grid;
    gap: var(--space-2);
    margin-top: auto;
    padding-top: var(--space-5);
  }

  .tier__outcome-text {
    font-family: var(--font-serif);
    font-weight: var(--weight-heading);
    font-size: var(--text-lg);
    line-height: 1.3;
  }

  .tier__cta {
    margin-top: var(--space-5);
  }

  .tiers-foot {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--col-gap);
    row-gap: var(--space-6);
    margin-top: var(--space-section-gap);
  }

  .tiers-foot__pricing,
  .tiers-foot__scope {
    padding: var(--space-inset-lg);
  }

  .tiers-foot__pricing {
    grid-column: 1 / 7;
  }

  .tiers-foot__scope {
    grid-column: 7 / 13;
  }

  .tiers-foot__label {
    margin-bottom: var(--space-3);
  }

  .tiers-foot p {
    color: var(--color-text-soft);
    max-width: 48ch;
  }

  .tiers-foot p + p {
    margin-top: var(--space-4);
  }

  .tiers-foot__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .tiers-foot__list li {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    padding: var(--space-chip);
    border: 1px solid var(--color-rule-strong);
    border-radius: var(--radius-sm);
    color: var(--color-text-soft);
  }

  @media (max-width: 1100px) {
    .tiers {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .tiers-foot__pricing,
    .tiers-foot__scope {
      grid-column: 1 / -1;
    }
  }
</style>
