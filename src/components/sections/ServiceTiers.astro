---
/** How billing works, and what Foresta does not take on. Shared by every plan. */
import { useI18n } from '@/i18n';

const { t } = useI18n(Astro);
---

<section class="section section--page billing-section" aria-labelledby="billing-title">
  <div class="container">
    <div class="tiers-foot" data-tiers-tree>
      <canvas class="tiers-tree__canvas" aria-hidden="true"></canvas>
      <div class="tiers-tree__limbs">
        <div class="tiers-tree__limb" data-limb>
          <h2 class="tiers-tree__name" id="billing-title" data-tip="limb">{t.services.howBilled}</h2>
          <ul class="tiers-tree__facts">
            <li data-tip="leaf">{t.services.currencyNote}</li>
            <li data-tip="leaf">{t.services.domainNote}</li>
            <li data-tip="leaf">{t.services.billing}</li>
            <li data-tip="leaf">{t.services.adSpend}</li>
            <li data-tip="leaf">{t.services.upgradeNote}</li>
          </ul>
        </div>
        <div class="tiers-tree__limb tiers-tree__limb--scope" data-limb>
          <h2 class="tiers-tree__name" data-tip="limb">{t.services.whatWeDont}</h2>
          <p class="tiers-tree__note" data-tip="leaf">{t.services.whatWeDontBody}</p>
          <ul class="tiers-tree__facts tiers-tree__facts--names">
            {t.services.notOffered.map((item) => <li data-tip="leaf">{item}</li>)}
          </ul>
        </div>
      </div>
    </div>
    <script>
      const trees = document.querySelectorAll('[data-tiers-tree]');
      for (const node of trees) {
        if (!(node instanceof HTMLElement)) continue;
        if (window.matchMedia('(max-width: 800px)').matches) continue;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const start = () => {
          void import('../../scripts/tiers-tree.ts').then((mod) => {
            mod.mountTiersTree(node, { reduce });
          });
        };
        if ('IntersectionObserver' in window) {
          const io = new IntersectionObserver(
            (entries) => {
              if (!entries.some((entry) => entry.isIntersecting)) return;
              io.disconnect();
              start();
            },
            { rootMargin: '280px' },
          );
          io.observe(node);
        } else {
          start();
        }
      }
    </script>
  </div>
</section>

<style>
  /* Billing and scope sit on a tree. A hairline stands in until WebGL draws.
     The section's own padding is the gap; this block no longer offsets itself. */
  .tiers-foot {
    position: relative;
    padding-bottom: var(--space-6);
  }

  .tiers-foot::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0.25rem;
    bottom: 3rem;
    width: 1px;
    background: var(--color-moss-800);
    opacity: 0.4;
    pointer-events: none;
  }

  .tiers-foot.is-ready::before {
    display: none;
  }

  .tiers-tree__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .tiers-tree__limbs {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: clamp(5.5rem, 11vw, 9rem);
    align-items: start;
  }

  .tiers-tree__limb {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    width: min(100%, 38ch);
  }

  /* Both columns share a top line. Each block fills the column, so every
     root meets the same inner edge. */
  .tiers-tree__limb:not(.tiers-tree__limb--scope) {
    justify-self: end;
  }

  .tiers-tree__limb--scope {
    justify-self: start;
  }

  .tiers-tree__name {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-xl);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-display);
    line-height: 1.1;
    color: var(--color-text);
  }

  .tiers-tree__note,
  .tiers-tree__facts li {
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--color-text-soft);
  }

  .tiers-tree__facts {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .tiers-tree__facts--names li {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: var(--weight-heading);
    line-height: 1.25;
    color: var(--color-text);
  }

  .tiers-tree__limb:not(.tiers-tree__limb--scope) :is(.tiers-tree__name, .tiers-tree__note, .tiers-tree__facts li) {
    padding-right: 0.75rem;
  }

  .tiers-tree__limb--scope :is(.tiers-tree__name, .tiers-tree__note, .tiers-tree__facts li) {
    padding-left: 0.75rem;
  }

  @media (max-width: 800px) {
    .tiers-foot {
      padding-bottom: 1.25rem;
    }

    .tiers-foot::before {
      left: 0.35rem;
      bottom: 0.5rem;
    }

    .tiers-tree__limbs {
      grid-template-columns: 1fr;
      row-gap: var(--space-7);
      padding-left: 2.4rem;
    }

    .tiers-tree__limb,
    .tiers-tree__limb:not(.tiers-tree__limb--scope),
    .tiers-tree__limb--scope {
      justify-self: stretch;
      width: 100%;
    }

    .tiers-tree__limb:not(.tiers-tree__limb--scope) :is(.tiers-tree__name, .tiers-tree__note, .tiers-tree__facts li),
    .tiers-tree__limb--scope :is(.tiers-tree__name, .tiers-tree__note, .tiers-tree__facts li) {
      position: relative;
      padding-right: 0;
      padding-left: 0.2rem;
    }

    /* A drawn root stands in for the WebGL one, which does not load here. */
    .tiers-tree__name::before,
    .tiers-tree__note::before,
    .tiers-tree__facts li::before {
      content: '';
      position: absolute;
      top: 0.55em;
      right: calc(100% + 0.15rem);
      width: 1.7rem;
      height: 1px;
      background: var(--color-moss-800);
      opacity: 0.55;
    }
  }
</style>
