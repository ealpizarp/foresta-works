---
import Botanical from '@/components/visuals/Botanical.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { useI18n } from '@/i18n';
import { routes } from '@/i18n/paths';

const { t, path } = useI18n(Astro);
---

<section class="section process-preview" aria-labelledby="process-preview-title">
  <div class="container">
    <SectionHeader
      number="03"
      label={t.homeProcess.label}
      title={t.homeProcess.title}
      titleId="process-preview-title"
      link={{ href: path(routes.proceso), label: t.homeProcess.seeProcess }}
    />

    <div class="steps-wrap">
      <div class="steps-vine" data-sway aria-hidden="true">
        <Botanical variant="rule" />
      </div>
      <ol class="steps">
      {t.process.steps.map((step, index) => (
        <li class="step reveal">
          <span class="step__num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <h3 class="step__title">{step.title}</h3>
        </li>
      ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .steps-wrap {
    position: relative;
  }

  .steps-vine {
    position: absolute;
    top: 0.35rem;
    left: 4%;
    right: 4%;
    width: auto;
    color: var(--color-moss-800);
    opacity: 0.45;
    pointer-events: none;
  }

  .steps-vine :global(svg) {
    height: 2.15rem;
  }

  .steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--col-gap);
  }

  .step {
    position: relative;
  }

  .step__num {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.35rem;
    height: 2.35rem;
    border-radius: var(--radius-pill);
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }

  .step__title {
    margin-top: var(--space-4);
    font-size: var(--text-lg);
    line-height: 1.2;
  }

  @media (max-width: 1100px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
    }

    .steps-vine {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .steps {
      grid-template-columns: 1fr;
    }

    .steps::before {
      content: '';
      position: absolute;
      top: 0.4rem;
      bottom: 0.4rem;
      left: 1.15rem;
      width: 1px;
      background: var(--color-sage-300);
      pointer-events: none;
    }
  }
</style>
