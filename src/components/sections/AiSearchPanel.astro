---
import Botanical from '@/components/visuals/Botanical.astro';
import InterfacePreview from '@/components/visuals/InterfacePreview.astro';
import { useI18n } from '@/i18n';

const { t } = useI18n(Astro);
---

<section class="section section--page ai-search" id="ai-search" aria-labelledby="ai-search-title">
  <div class="container ai-search__grid">
    <p class="eyebrow ai-search__eyebrow">
      <span class="eyebrow__num">04</span>
      {t.aiSearch.eyebrow}
    </p>

    <div class="ai-search__copy">
      <h2 class="ai-search__title" id="ai-search-title">{t.aiSearch.title}</h2>
      <p class="ai-search__lede">{t.aiSearch.lede}</p>
      <h3 class="ai-search__note">{t.aiSearch.noteLabel}</h3>
      <p class="ai-search__distinction">{t.aiSearch.distinction}</p>
      <p class="ai-search__included">{t.aiSearch.includedNote}</p>
    </div>

    <figure class="ai-search__visual">
      <InterfacePreview kind="search" size="card" />
      <figcaption>{t.aiSearch.caption}</figcaption>
    </figure>

    <div class="ai-search__rule" data-sway aria-hidden="true">
      <Botanical variant="rule" />
    </div>

    <div class="ai-search__list">
      <h3 class="ai-search__list-title">{t.aiSearch.includesLabel}</h3>
      <ul>
        {t.aiSearch.includes.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <div class="ai-search__list ai-search__list--out">
      <h3 class="ai-search__list-title">{t.aiSearch.excludesLabel}</h3>
      <ul>
        {t.aiSearch.excludes.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .ai-search__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    column-gap: clamp(2rem, 4vw, 4.5rem);
    row-gap: var(--space-6);
    align-items: start;
  }

  .ai-search__eyebrow {
    grid-column: 1 / -1;
    grid-row: 1;
  }

  .ai-search__copy {
    grid-column: 1;
    grid-row: 2;
    min-width: 0;
  }

  .ai-search__title {
    font-size: var(--text-2xl);
    line-height: var(--leading-snug);
    max-width: 18ch;
  }

  .ai-search__lede {
    margin-top: var(--space-5);
    font-size: var(--text-md);
    color: var(--color-text-soft);
    max-width: 46ch;
  }

  .ai-search__note {
    margin-top: var(--space-7);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-xl);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-display);
    line-height: 1.15;
  }

  .ai-search__distinction {
    margin-top: var(--space-4);
    max-width: 52ch;
    color: var(--color-text-soft);
  }

  .ai-search__included {
    margin-top: var(--space-4);
    max-width: 46ch;
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: var(--weight-heading);
    line-height: 1.35;
    color: var(--color-text);
  }

  .ai-search__visual {
    grid-column: 2;
    grid-row: 2;
    justify-self: end;
    align-self: end;
    width: min(100%, 14.5rem);
    margin: 0;
  }

  .ai-search__visual :global(.preview),
  .ai-search__visual :global(.browser),
  .ai-search__visual :global(.screen) {
    height: auto;
    min-height: 0;
  }

  .ai-search__visual figcaption {
    margin-top: var(--space-3);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    max-width: 28ch;
  }

  .ai-search__rule {
    grid-column: 1 / -1;
    grid-row: 3;
    color: var(--color-moss-800);
    opacity: 0.55;
    pointer-events: none;
  }

  .ai-search__rule :global(svg) {
    height: 2.25rem;
  }

  .ai-search__list {
    grid-column: 1;
    grid-row: 4;
    min-width: 0;
  }

  .ai-search__list--out {
    grid-column: 2;
    grid-row: 4;
    margin-top: 2.75rem;
  }

  .ai-search__list-title {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-xl);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-display);
    line-height: 1.15;
  }

  .ai-search__list li {
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-rule);
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: var(--weight-heading);
    line-height: 1.3;
    color: var(--color-text);
  }

  .ai-search__list li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  @media (max-width: 900px) {
    .ai-search__copy,
    .ai-search__list,
    .ai-search__list--out {
      grid-column: 1 / -1;
      grid-row: auto;
    }

    .ai-search__visual {
      display: none;
    }

    .ai-search__title {
      max-width: 16ch;
    }

    .ai-search__list--out {
      margin-top: 0;
    }
  }
</style>
