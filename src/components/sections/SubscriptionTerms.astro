---
/** Billing, commitment, cancellation, and renewal — the same rules for every plan. */
import { interpolate, useI18n } from '@/i18n';
import { subscriptionNumbers } from '@/data/services';

const { t } = useI18n(Astro);
const billingVars = {
  months: String(subscriptionNumbers.recommendedMonths),
  days: String(subscriptionNumbers.noticeDays),
  hour: String(subscriptionNumbers.extrasHourUsd),
};
const terms = [
  { label: t.services.terms.commitment, body: interpolate(t.services.commitment, billingVars) },
  { label: t.services.terms.cancellation, body: interpolate(t.services.cancellation, billingVars) },
  { label: t.services.terms.renewal, body: t.services.renewal },
  { label: t.services.terms.extras, body: interpolate(t.services.extras, billingVars) },
];
---

<section class="section section--page terms" id="terms" aria-labelledby="terms-title">
  <div class="container">
    <div class="terms__intro">
      <h2 class="terms__title" id="terms-title">{t.services.termsTitle}</h2>
    </div>

    <div class="terms__system">
      <div class="terms__canopy" data-sway aria-hidden="true">
        <svg viewBox="0 0 1200 48" width="1200" height="48" preserveAspectRatio="none" fill="none">
          <path
            d="M0 30 C 70 30 110 22 190 28 C 280 35 340 18 430 26 C 530 35 590 16 690 26 C 790 36 850 18 960 28 C 1060 36 1120 24 1200 28"
            stroke="currentColor"
            stroke-width="1.35"
            stroke-linecap="round"
            vector-effect="non-scaling-stroke"
          />
          <path d="M150 28 C 138 16 124 10 108 12" stroke="currentColor" stroke-width="1.05" stroke-linecap="round" vector-effect="non-scaling-stroke" />
          <path d="M320 24 C 308 36 294 44 276 46" stroke="currentColor" stroke-width="1.05" stroke-linecap="round" vector-effect="non-scaling-stroke" />
          <path d="M560 22 C 572 12 588 8 604 12" stroke="currentColor" stroke-width="1.05" stroke-linecap="round" vector-effect="non-scaling-stroke" />
          <path d="M820 28 C 808 40 792 46 774 44" stroke="currentColor" stroke-width="1.05" stroke-linecap="round" vector-effect="non-scaling-stroke" />
          <path d="M1040 26 C 1054 14 1072 10 1090 14" stroke="currentColor" stroke-width="1.05" stroke-linecap="round" vector-effect="non-scaling-stroke" />
        </svg>
      </div>

      <ol class="terms__grid">
        {
          terms.map((term) => (
            <li class="terms__item panel reveal">
              <svg class="terms__spur" viewBox="0 0 80 48" width="80" height="48" fill="none" aria-hidden="true">
                <g class="terms__spur-up">
                  <path d="M40 0 C 36 12 44 22 40 34" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
                  <path d="M40 14 C 28 10 16 12 8 8" stroke="currentColor" stroke-width="1.05" stroke-linecap="round" />
                </g>
                <g class="terms__spur-side">
                  <path d="M0 24 C 16 22 28 26 52 24" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
                  <path d="M24 24 C 30 14 38 10 48 14" stroke="currentColor" stroke-width="1.05" stroke-linecap="round" />
                </g>
              </svg>
              <h3 class="label">{term.label}</h3>
              <p>{term.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .terms__intro {
    max-width: 28rem;
    margin-bottom: var(--space-6);
  }

  .terms__title {
    font-size: var(--text-2xl);
    line-height: var(--leading-snug);
  }

  .terms__system {
    position: relative;
  }

  .terms__canopy {
    height: 2.75rem;
    margin-bottom: -0.2rem;
    color: var(--color-moss-800);
    opacity: 0.62;
    pointer-events: none;
  }

  .terms__canopy svg {
    display: block;
    width: 100%;
    height: 2.75rem;
  }

  .terms__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--col-gap);
  }

  .terms__item {
    position: relative;
    z-index: 1;
    padding: var(--space-inset);
  }

  .terms__item h3,
  .terms__item p {
    position: relative;
    z-index: 1;
  }

  .terms__spur {
    position: absolute;
    z-index: 0;
    left: 50%;
    bottom: 100%;
    width: 3.4rem;
    height: 1.85rem;
    transform: translateX(-50%);
    color: var(--color-moss-800);
    opacity: 0.7;
    pointer-events: none;
  }

  .terms__spur-side {
    display: none;
  }

  .terms__item p {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-soft);
    max-width: 36ch;
  }

  @media (max-width: 1100px) {
    .terms__grid {
      grid-template-columns: repeat(2, 1fr);
      row-gap: calc(var(--col-gap) + 2.75rem);
    }
  }

  @media (max-width: 600px) {
    .terms__canopy {
      display: none;
    }

    .terms__grid {
      grid-template-columns: 1fr;
      row-gap: var(--col-gap);
      padding-left: 1.5rem;
    }

    .terms__grid::before {
      content: '';
      position: absolute;
      left: 0.4rem;
      top: 1.4rem;
      bottom: 1.4rem;
      width: 1px;
      background: var(--color-moss-800);
      opacity: 0.55;
    }

    .terms__spur {
      left: -1.5rem;
      top: 1.15rem;
      bottom: auto;
      width: 1.45rem;
      height: 1.35rem;
      transform: none;
    }

    .terms__spur-up {
      display: none;
    }

    .terms__spur-side {
      display: block;
    }
  }
</style>
