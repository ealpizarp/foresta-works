<style>
  .botanical {
    display: block;
    width: 4.5rem;
    height: auto;
    color: inherit;
  }

  .botanical--rule {
    display: block;
    width: 100%;
    max-width: 100%;
    height: 4.75rem;
    color: inherit;
  }
</style>
