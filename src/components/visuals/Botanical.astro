---
/**
 * Decorative branch line. Sprig is a standing cutting; rule is a path
 * stretched across a row of steps or a footer. Never conveys information.
 */
interface Props {
  variant?: 'sprig' | 'rule';
  class?: string;
}

const { variant = 'sprig', class: className } = Astro.props;
