---
/**
 * Root cluster for the about page. A seed, a short stem, and lateral
 * roots — the same moss line as the other drawings, and a new path.
 * Growth runs once. Reduced motion shows the finished drawing.
 */
---

<div class="care-roots">
  <svg class="care-roots__emboss" viewBox="0 0 280 300" fill="none" aria-hidden="true">
    <path d="M140 176 C 86 210 40 248 18 286" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
    <path d="M140 176 C 196 212 244 246 266 284" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
    <path d="M140 168 C 118 132 108 96 116 58" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" />
  </svg>

  <svg class="care-roots__draw" viewBox="0 0 280 300" fill="none" aria-hidden="true">
    <path class="care-roots__path" pathLength="100" d="M140 168 C 136 142 130 118 126 96" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
    <path class="care-roots__leaf" pathLength="100" d="M126 108 C 98 100 74 86 64 66 C 94 72 114 90 126 108Z" stroke="currentColor" stroke-width="1.15" stroke-linejoin="round" />
    <path class="care-roots__leaf" pathLength="100" d="M130 96 C 154 82 178 74 196 82 C 174 94 152 102 130 96Z" stroke="currentColor" stroke-width="1.15" stroke-linejoin="round" />
    <path class="care-roots__path care-roots__path--tap" pathLength="100" d="M140 180 C 134 214 122 248 108 278" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" />
    <path class="care-roots__path care-roots__path--left" pathLength="100" d="M140 178 C 108 198 72 214 36 236" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
    <path class="care-roots__path care-roots__path--right" pathLength="100" d="M142 178 C 176 200 214 218 252 240" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
    <path class="care-roots__hair" pathLength="100" d="M118 214 C 96 226 78 246 70 268" stroke="currentColor" stroke-width="1.05" stroke-linecap="round" />
    <path class="care-roots__hair" pathLength="100" d="M168 208 C 190 222 206 244 214 266" stroke="currentColor" stroke-width="1.05" stroke-linecap="round" />
    <path class="care-roots__hair" pathLength="100" d="M78 214 C 64 204 52 206 42 216" stroke="currentColor" stroke-width="1.05" stroke-linecap="round" />
    <circle cx="140" cy="174" r="10" fill="none" stroke="currentColor" stroke-width="1" opacity="0.4" />
    <circle class="care-roots__seed" cx="140" cy="174" r="4.25" />
  </svg>
</div>

<style>
  .care-roots {
    position: relative;
    width: min(100%, 17rem);
    aspect-ratio: 280 / 300;
    color: var(--color-moss-800);
  }

  .care-roots__emboss,
  .care-roots__draw {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .care-roots__emboss {
    color: var(--color-sage-300);
    opacity: 0.9;
  }

  .care-roots__seed {
    fill: var(--color-clay);
  }

  @media (prefers-reduced-motion: no-preference) {
    .care-roots__path,
    .care-roots__hair,
    .care-roots__leaf {
      stroke-dasharray: 100;
      stroke-dashoffset: 100;
      animation: care-roots-grow 1.35s var(--ease-out) forwards;
    }

    .care-roots__path--tap { animation-delay: 0.12s; }
    .care-roots__path--right { animation-delay: 0.22s; }
    .care-roots__path--left { animation-delay: 0.3s; }
    .care-roots__hair { animation-delay: 0.42s; animation-duration: 1.05s; }
    .care-roots__leaf { animation-delay: 0.5s; animation-duration: 0.9s; }
  }

  @keyframes care-roots-grow {
    to { stroke-dashoffset: 0; }
  }
</style>
