---
/**
 * One engagement, drawn as one plant. Wide stations: a seed (conversation),
 * one rising shoot (written plan), a fork (build), roots (launch), and a
 * crown (month to month). Each station carries one paper note — the stage
 * title and its paragraph — in the open air beside that vertex.
 * Below 1100px the same plant is redrawn and the notes stack under it.
 * Growth runs once. Notes rise in that same order. Reduced motion shows
 * the finished drawing and every note immediately.
 */
interface Step {
  title: string;
  text: string;
}

interface Props {
  steps: readonly Step[];
}

const { steps } = Astro.props;
const stations = ['conversation', 'plan', 'build', 'launch', 'month'] as const;
---

<div class="process-field">
  <div class="process-field--wide" aria-hidden="true">
    <svg class="process-field__emboss" viewBox="0 0 1000 300" fill="none">
      <path d="M0 258 C 170 276 400 236 640 258 C 800 272 910 244 1000 258" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
      <path d="M14 208 C 2 230 6 246 0 258" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" />
      <path d="M120 262 C 180 278 250 272 300 260" stroke="currentColor" stroke-width="1.05" stroke-linecap="round" />
    </svg>

    <svg class="process-field__draw" viewBox="0 0 1000 300" fill="none">
      <path class="process-field__path process-field__path--spine" pathLength="100" d="M14 196 C 70 186 140 170 219 158 C 290 146 360 122 424 108 C 500 128 570 166 629 176 C 700 194 770 146 833 122" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      <path class="process-field__path process-field__path--plan" pathLength="100" d="M219 158 C 230 122 244 88 256 54" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
      <path class="process-field__path process-field__path--build" pathLength="100" d="M424 108 C 398 82 376 54 354 30" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
      <path class="process-field__path process-field__path--build" pathLength="100" d="M424 108 C 456 80 488 52 516 28" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
      <path class="process-field__path process-field__path--root" pathLength="100" d="M629 176 C 588 206 558 238 544 258" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
      <path class="process-field__path process-field__path--root" pathLength="100" d="M629 176 C 674 206 716 240 742 266" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
      <path class="process-field__path process-field__path--crown" pathLength="100" d="M833 122 C 822 96 812 68 802 42" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
      <path class="process-field__path process-field__path--crown" pathLength="100" d="M833 122 C 854 108 876 102 900 88" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
      <path class="process-field__hair" pathLength="100" d="M72 185 C 56 172 46 166 32 154" stroke="currentColor" stroke-width="1.05" stroke-linecap="round" />
      <path class="process-field__hair" pathLength="100" d="M256 54 C 268 44 276 48 288 38" stroke="currentColor" stroke-width="1.05" stroke-linecap="round" />
      <path class="process-field__hair" pathLength="100" d="M802 42 C 788 30 784 20 792 14" stroke="currentColor" stroke-width="1.05" stroke-linecap="round" />
      <path class="process-field__hair" pathLength="100" d="M802 42 C 816 28 820 18 812 12" stroke="currentColor" stroke-width="1.05" stroke-linecap="round" />
      <path class="process-field__hair" pathLength="100" d="M900 88 C 912 78 920 82 932 72" stroke="currentColor" stroke-width="1.05" stroke-linecap="round" />
      <circle cx="14" cy="196" r="10.5" fill="none" stroke="currentColor" stroke-width="1" opacity="0.4" />
      <circle class="process-field__seed" cx="14" cy="196" r="4.2" fill="currentColor" />
      <circle cx="219" cy="158" r="3.15" fill="currentColor" />
      <circle cx="424" cy="108" r="3.15" fill="currentColor" />
      <circle cx="629" cy="176" r="3.15" fill="currentColor" />
      <circle cx="833" cy="122" r="3.15" fill="currentColor" />
      <circle cx="256" cy="54" r="2.35" fill="currentColor" />
      <circle cx="354" cy="30" r="2.35" fill="currentColor" />
      <circle cx="516" cy="28" r="2.35" fill="currentColor" />
      <circle cx="900" cy="88" r="2.35" fill="currentColor" />
      <circle cx="802" cy="42" r="2.6" fill="var(--color-clay)" />
    </svg>
  </div>

  <div class="process-field--stack" aria-hidden="true">
    <svg class="process-field__emboss" viewBox="0 0 520 280" fill="none">
      <path d="M8 248 C 120 266 280 228 400 248 C 460 258 500 238 516 248" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" />
      <path d="M40 188 C 26 210 22 232 16 248" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
    </svg>

    <svg class="process-field__draw" viewBox="0 0 520 280" fill="none">
      <path class="process-field__path process-field__path--spine" pathLength="100" d="M40 176 C 78 164 118 150 148 140 C 190 124 230 106 258 100 C 300 118 340 158 368 168 C 400 180 428 136 452 116" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
      <path class="process-field__path process-field__path--plan" pathLength="100" d="M148 140 C 156 112 166 86 178 60" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      <path class="process-field__path process-field__path--build" pathLength="100" d="M258 100 C 236 76 220 52 202 32" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      <path class="process-field__path process-field__path--build" pathLength="100" d="M258 100 C 284 74 306 50 328 30" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      <path class="process-field__path process-field__path--root" pathLength="100" d="M368 168 C 338 198 318 228 304 248" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      <path class="process-field__path process-field__path--root" pathLength="100" d="M368 168 C 402 198 430 226 452 250" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      <path class="process-field__path process-field__path--crown" pathLength="100" d="M452 116 C 444 92 436 66 426 44" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      <path class="process-field__path process-field__path--crown" pathLength="100" d="M452 116 C 470 102 486 100 504 86" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      <path class="process-field__hair" pathLength="100" d="M90 158 C 74 144 66 138 52 128" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
      <path class="process-field__hair" pathLength="100" d="M178 60 C 190 50 198 54 210 44" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
      <path class="process-field__hair" pathLength="100" d="M426 44 C 412 32 408 22 416 16" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
      <path class="process-field__hair" pathLength="100" d="M426 44 C 440 30 444 20 436 14" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
      <circle cx="40" cy="176" r="9" fill="none" stroke="currentColor" stroke-width="1.1" opacity="0.4" />
      <circle class="process-field__seed" cx="40" cy="176" r="3.8" fill="currentColor" />
      <circle cx="148" cy="140" r="2.8" fill="currentColor" />
      <circle cx="258" cy="100" r="2.8" fill="currentColor" />
      <circle cx="368" cy="168" r="2.8" fill="currentColor" />
      <circle cx="452" cy="116" r="2.8" fill="currentColor" />
      <circle cx="178" cy="60" r="2.1" fill="currentColor" />
      <circle cx="202" cy="32" r="2.1" fill="currentColor" />
      <circle cx="328" cy="30" r="2.1" fill="currentColor" />
      <circle cx="426" cy="44" r="2.5" fill="var(--color-clay)" />
    </svg>
  </div>

  <ol class="process-notes">
    {
      steps.map((step, index) => (
        <li class:list={['note', stations[index] ? `note--${stations[index]}` : undefined]}>
          <span class="note__stem" aria-hidden="true" />
          <div class="note__head">
            <span class="note__num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <h3 class="note__title">{step.title}</h3>
          </div>
          <p class="note__text">{step.text}</p>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .process-field {
    --note-band: 15.5rem;
    --note-band-end: 15.5rem;
    position: relative;
    display: flow-root;
    width: 100%;
    padding-top: var(--note-band);
    padding-bottom: var(--note-band-end);
    color: var(--color-moss-800);
  }

  .process-field--wide,
  .process-field--stack {
    position: relative;
    width: 100%;
  }

  .process-field--wide {
    aspect-ratio: 1000 / 300;
  }

  .process-field--stack {
    display: none;
    aspect-ratio: 520 / 280;
  }

  .process-field__emboss,
  .process-field__draw {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .process-field__emboss {
    color: var(--color-sage-300);
    opacity: 0.9;
  }

  /* Notes share the plant's box, so percentages match the 1000×300 viewBox.
     Each note sits in open air; the stem is the short corner toward the vertex. */
  .process-notes {
    position: absolute;
    left: 0;
    right: 0;
    top: var(--note-band);
    bottom: var(--note-band-end);
    margin: 0;
    pointer-events: none;
    container-type: inline-size;
  }

  .note {
    position: absolute;
    z-index: 1;
    margin: 0;
    padding: 0.7rem 0.9rem 0.8rem;
    pointer-events: auto;
    background: var(--color-paper);
    border: 1px solid var(--color-rule-strong);
    border-radius: 0.7rem;
    box-shadow: var(--shadow-sm);
    color: var(--color-text);
  }

  .note__stem {
    position: absolute;
    width: 1.5px;
    background: var(--color-moss-800);
    pointer-events: none;
  }

  .note__head {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .note__num {
    flex: none;
    display: grid;
    place-items: center;
    width: 1.85rem;
    height: 1.85rem;
    border-radius: var(--radius-pill);
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }

  .note__title {
    font-family: var(--font-serif);
    font-size: var(--text-md);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-display);
    line-height: 1.15;
    color: var(--color-primary-strong);
  }

  .note__text {
    margin-top: 0.45rem;
    max-width: none;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-text-soft);
  }

  /* Seed (14, 196). The note hangs just below it. */
  .note--conversation {
    left: 0;
    top: 73%;
    width: min(19rem, 34%);
    border-top-left-radius: 0.15rem;
  }

  .note--conversation .note__stem {
    top: -1.45rem;
    left: 1.4cqw;
    height: 1.45rem;
  }

  /* Rising shoot tip (256, 54). The note sits above-left of it. */
  .note--plan {
    left: 0;
    bottom: 84.5%;
    width: calc(25.2% - 0.85rem);
    border-bottom-right-radius: 0.15rem;
  }

  .note--plan .note__stem {
    right: 0.1rem;
    bottom: -0.2rem;
    height: 1.2rem;
    transform-origin: top center;
    rotate: 48deg;
  }

  /* Fork tips near y=28–30. The note sits just above them. */
  .note--build {
    left: 33%;
    bottom: 96%;
    width: min(20rem, 30%);
    border-bottom-left-radius: 0.15rem;
    border-bottom-right-radius: 0.15rem;
  }

  .note--build .note__stem {
    left: 10.5cqw;
    bottom: -1.05rem;
    height: 1.05rem;
  }

  /* Root tips near y=258–266. The note sits just beneath them. */
  .note--launch {
    left: 44%;
    top: 92%;
    width: min(22rem, 34%);
    border-top-left-radius: 0.15rem;
    border-top-right-radius: 0.15rem;
  }

  .note--launch .note__stem {
    left: 10.4cqw;
    top: -1.5rem;
    height: 1.5rem;
  }

  /* Crown leaf (802, 42) reaches the top edge. The note sits just above it. */
  .note--month {
    left: 74%;
    bottom: calc(100% + 0.2rem);
    width: min(18.5rem, 25%);
    border-bottom-left-radius: 0.15rem;
  }

  .note--month .note__stem {
    left: 5cqw;
    bottom: -1.25rem;
    height: 1.25rem;
  }

  @media (max-width: 1100px) {
    .process-field {
      --note-band: 0rem;
      --note-band-end: 0rem;
      padding-top: 0;
      padding-bottom: 0;
    }

    .process-field--wide {
      display: none;
    }

    .process-field--stack {
      display: block;
    }

    .process-notes {
      position: static;
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      margin-top: var(--space-5);
      pointer-events: auto;
    }

    .note {
      position: relative;
      inset: auto;
      width: auto;
      max-width: 40rem;
      min-width: 0;
    }

    .note__stem {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .process-field__path,
    .process-field__hair {
      stroke-dasharray: 100;
      stroke-dashoffset: 100;
      animation: process-grow 1.25s var(--ease-out) forwards;
    }

    .process-field__path--plan { animation-delay: 0.28s; }
    .process-field__path--build { animation-delay: 0.46s; }
    .process-field__path--root { animation-delay: 0.64s; }
    .process-field__path--crown { animation-delay: 0.8s; }
    .process-field__hair { animation-delay: 0.95s; animation-duration: 0.8s; }

    .note {
      animation: note-rise 0.65s var(--ease-out) backwards;
    }

    .note--conversation { animation-delay: 0.42s; }
    .note--plan { animation-delay: 0.78s; }
    .note--build { animation-delay: 1.02s; }
    .note--launch { animation-delay: 1.24s; }
    .note--month { animation-delay: 1.46s; }
  }

  @keyframes process-grow {
    to { stroke-dashoffset: 0; }
  }

  @keyframes note-rise {
    from {
      opacity: 0;
      translate: 0 0.45rem;
    }
  }
</style>
