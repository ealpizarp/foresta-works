---
/**
 * One plant, three stages, for the plan cards. Arranque is a young
 * plant. Crecimiento is the full crown. Inteligente already has a
 * trunk and then one later shoot. Decorative; the card carries the words.
 * Growth runs once. Reduced motion shows the finished drawing.
 */
interface Props {
  stage: 'arranque' | 'crecimiento' | 'inteligente';
}

const { stage } = Astro.props;

const frame = {
  arranque: { width: 96, height: 108 },
  crecimiento: { width: 136, height: 172 },
  inteligente: { width: 120, height: 148 },
}[stage];
---

<svg
  class:list={['plan-tree', `plan-tree--${stage}`]}
  viewBox={`0 0 ${frame.width} ${frame.height}`}
  width={frame.width}
  height={frame.height}
  fill="none"
  aria-hidden="true"
>
  {
    stage === 'arranque' && (
      <>
        <g class="plan-tree__emboss">
          <path d="M44 82 C 47 70 36 58 40 46" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" vector-effect="non-scaling-stroke" />
          <path d="M42 64 C 32 68 22 58 14 50" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" vector-effect="non-scaling-stroke" />
          <path d="M41 56 C 52 60 62 50 70 42" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" vector-effect="non-scaling-stroke" />
        </g>
        <g class="plan-tree__draw">
          <path class="plan-tree__path plan-tree__path--trunk" pathLength="100" d="M44 82 C 47 70 36 58 40 46" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" vector-effect="non-scaling-stroke" />
          <path class="plan-tree__path plan-tree__path--limb" pathLength="100" d="M42 64 C 32 68 22 58 14 50" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" vector-effect="non-scaling-stroke" />
          <path class="plan-tree__path plan-tree__path--limb" pathLength="100" d="M41 56 C 52 60 62 50 70 42" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" vector-effect="non-scaling-stroke" />
          <circle cx="44" cy="90" r="8.5" fill="none" stroke="currentColor" stroke-width="1" opacity="0.4" vector-effect="non-scaling-stroke" />
          <circle cx="44" cy="90" r="3.6" fill="currentColor" />
          <circle class="plan-tree__bud" cx="40" cy="46" r="3.3" fill="var(--color-clay)" />
        </g>
      </>
    )
  }
  {
    stage === 'crecimiento' && (
      <>
        <g class="plan-tree__emboss">
          <path d="M66 146 C 70 126 54 106 58 86" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" vector-effect="non-scaling-stroke" />
          <path d="M58 86 C 62 66 48 48 54 32" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" vector-effect="non-scaling-stroke" />
          <path d="M62 124 C 48 122 30 112 16 102" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" vector-effect="non-scaling-stroke" />
          <path d="M62 118 C 80 116 98 106 114 96" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" vector-effect="non-scaling-stroke" />
        </g>
        <g class="plan-tree__draw">
          <path class="plan-tree__path plan-tree__path--trunk" pathLength="100" d="M66 146 C 70 126 54 106 58 86" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" vector-effect="non-scaling-stroke" />
          <path class="plan-tree__path plan-tree__path--trunk" pathLength="100" d="M58 86 C 62 66 48 48 54 32" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" vector-effect="non-scaling-stroke" />
          <path class="plan-tree__path plan-tree__path--limb" pathLength="100" d="M62 124 C 48 122 30 112 16 102" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" vector-effect="non-scaling-stroke" />
          <path class="plan-tree__path plan-tree__path--limb" pathLength="100" d="M62 118 C 80 116 98 106 114 96" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" vector-effect="non-scaling-stroke" />
          <path class="plan-tree__path plan-tree__path--limb" pathLength="100" d="M58 104 C 44 98 30 86 18 72" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" vector-effect="non-scaling-stroke" />
          <path class="plan-tree__path plan-tree__path--limb" pathLength="100" d="M58 96 C 76 90 94 76 110 62" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" vector-effect="non-scaling-stroke" />
          <path class="plan-tree__path plan-tree__path--crown" pathLength="100" d="M54 54 C 40 50 26 40 16 28" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" vector-effect="non-scaling-stroke" />
          <path class="plan-tree__path plan-tree__path--crown" pathLength="100" d="M54 46 C 72 40 90 28 108 16" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" vector-effect="non-scaling-stroke" />
          <path class="plan-tree__path plan-tree__path--crown" pathLength="100" d="M56 74 C 70 66 82 56 92 46" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" vector-effect="non-scaling-stroke" />
          <path class="plan-tree__path plan-tree__path--crown" pathLength="100" d="M54 32 C 46 24 42 18 36 12" stroke="currentColor" stroke-width="1.05" stroke-linecap="round" vector-effect="non-scaling-stroke" />
          <circle cx="66" cy="154" r="9.5" fill="none" stroke="currentColor" stroke-width="1" opacity="0.4" vector-effect="non-scaling-stroke" />
          <circle cx="66" cy="154" r="4" fill="currentColor" />
          <circle class="plan-tree__bud" cx="108" cy="16" r="3.6" fill="var(--color-clay)" />
        </g>
      </>
    )
  }
  {
    stage === 'inteligente' && (
      <>
        <g class="plan-tree__emboss">
          <path d="M52 120 C 54 104 46 88 50 72" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" vector-effect="non-scaling-stroke" />
          <path d="M50 72 C 52 58 48 46 52 34" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" vector-effect="non-scaling-stroke" />
          <path d="M50 98 C 38 94 26 86 14 76" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" vector-effect="non-scaling-stroke" />
        </g>
        <g class="plan-tree__draw">
          <path class="plan-tree__path plan-tree__path--trunk" pathLength="100" d="M52 120 C 54 104 46 88 50 72" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" vector-effect="non-scaling-stroke" />
          <path class="plan-tree__path plan-tree__path--trunk" pathLength="100" d="M50 72 C 52 58 48 46 52 34" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" vector-effect="non-scaling-stroke" />
          <path class="plan-tree__path plan-tree__path--limb" pathLength="100" d="M50 98 C 38 94 26 86 14 76" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" vector-effect="non-scaling-stroke" />
          <path class="plan-tree__path plan-tree__path--shoot" pathLength="100" d="M51 54 C 64 50 78 40 94 30" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" vector-effect="non-scaling-stroke" />
          <path class="plan-tree__path plan-tree__path--shoot" pathLength="100" d="M76 40 C 84 34 92 30 100 24" stroke="currentColor" stroke-width="1.05" stroke-linecap="round" vector-effect="non-scaling-stroke" />
          <circle cx="52" cy="128" r="9" fill="none" stroke="currentColor" stroke-width="1" opacity="0.4" vector-effect="non-scaling-stroke" />
          <circle cx="52" cy="128" r="3.8" fill="currentColor" />
          <circle class="plan-tree__bud" cx="100" cy="24" r="3.5" fill="var(--color-clay)" />
        </g>
      </>
    )
  }
</svg>

<style>
  .plan-tree {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 96 / 108;
    color: var(--color-moss-800);
    overflow: visible;
  }

  .plan-tree--crecimiento {
    aspect-ratio: 136 / 172;
  }

  .plan-tree--inteligente {
    aspect-ratio: 120 / 148;
  }

  .plan-tree__emboss {
    color: var(--color-sage-300);
    opacity: 0.9;
    transform: translate(1.6px, 2px);
  }

  /* One draw, from the seed outward. Arranque finishes first.
     Crecimiento keeps growing the longest. Inteligente's shoot
     starts only after its trunk is down. */
  @media (prefers-reduced-motion: no-preference) {
    .plan-tree__path {
      stroke-dasharray: 100;
      stroke-dashoffset: 100;
      animation: plan-tree-grow 0.72s var(--ease-out) forwards;
    }

    .plan-tree--arranque .plan-tree__path--limb {
      animation-duration: 0.62s;
      animation-delay: 0.28s;
    }

    .plan-tree--crecimiento .plan-tree__path--trunk {
      animation-duration: 1.15s;
    }

    .plan-tree--crecimiento .plan-tree__path--limb {
      animation-duration: 1.05s;
      animation-delay: 0.46s;
    }

    .plan-tree--crecimiento .plan-tree__path--crown {
      animation-duration: 1.05s;
      animation-delay: 0.98s;
    }

    .plan-tree--inteligente .plan-tree__path--trunk,
    .plan-tree--inteligente .plan-tree__path--limb {
      animation-duration: 0.88s;
    }

    .plan-tree--inteligente .plan-tree__path--shoot {
      animation-duration: 0.7s;
      animation-delay: 0.96s;
    }

    .plan-tree__bud {
      opacity: 0;
      animation: plan-tree-bud 0.35s var(--ease-out) forwards;
    }

    .plan-tree--arranque .plan-tree__bud {
      animation-delay: 0.7s;
    }

    .plan-tree--crecimiento .plan-tree__bud {
      animation-delay: 1.72s;
    }

    .plan-tree--inteligente .plan-tree__bud {
      animation-delay: 1.4s;
    }
  }

  @keyframes plan-tree-grow {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes plan-tree-bud {
    to {
      opacity: 1;
    }
  }
</style>
