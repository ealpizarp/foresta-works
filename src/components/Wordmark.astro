---
/**
 * Text wordmark. No logo asset was supplied with the project; when one is
 * available, replace the text with an inline SVG here and keep the link.
 * TODO(assets): add the official Foresta Works logo.
 */
import { site } from '@/data/site';
import { interpolate, routes, useI18n, type Locale } from '@/i18n';

interface Props {
  onDark?: boolean;
  locale?: Locale;
}

const { onDark = false, locale: localeProp } = Astro.props;
const { t, path } = useI18n(Astro, localeProp);
---

<a
  class:list={['wordmark', { 'wordmark--on-dark': onDark }]}
  href={path(routes.home)}
  aria-label={interpolate(t.meta.homeAria, { name: site.name })}
>
  <svg class="wordmark__leaf" viewBox="0 0 20 20" width="16" height="16" fill="none" aria-hidden="true">
    <path
      d="M3.5 16.5 C 6 8.5 11.5 4.5 17 3.2 C 15.8 9.2 12 14.2 3.5 16.5Z"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linejoin="round"
    />
    <path d="M7.2 12.6 C 9.2 10 11.8 8 15.2 6.6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
  </svg>
  {site.name}
</a>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-serif);
    font-size: 1.375rem;
    font-weight: var(--weight-heading);
    letter-spacing: -0.01em;
    line-height: 1;
    color: var(--color-text);
    white-space: nowrap;
  }

  .wordmark__leaf {
    flex: none;
    width: 0.95rem;
    height: 0.95rem;
    min-width: 0.95rem;
    color: var(--color-primary);
  }

  .wordmark--on-dark {
    color: var(--color-dark-text);
  }

  .wordmark--on-dark .wordmark__leaf {
    color: var(--color-dark-accent);
  }

  @media (max-width: 420px) {
    .wordmark {
      font-size: 1.2rem;
    }
  }
</style>
