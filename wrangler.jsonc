// Cloudflare Workers: static assets plus a small worker for cookie-aware
// locale redirects (`src/edge/worker.ts`). No secrets belong here.
//
// Deploy (after `npm run build`):   npx wrangler deploy
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "foresta-works-website",
  "compatibility_date": "2026-09-01",
  "main": "src/edge/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  }
}
